<UserControl x:Class="Ecl.App.Dialogs.Views.MessageDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20,0,20,18">
        <TextBlock x:Name="MessageText"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"
                    Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="SecondaryButton"
                    Content="{Binding SecondaryText}"
                    Command="{Binding SecondaryCommand}"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"
                    Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="PrimaryButton"
                    Content="{Binding PrimaryText}"
                    Command="{Binding PrimaryCommand}"
                    IsDefault="{Binding IsSingleAction}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>

<UserControl x:Class="Ecl.App.Dialogs.Views.ContentDetailDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <!--
        下载中心内容详情（`download-mods.md` §6 / `download-modpacks.md` §7 /
        `download-resource-template.md` §7）：只显示被点击来源的项目信息与版本清单。
        有筛选时上表是匹配版本、下表是全部版本，允许重复；简介只在自身区域内滚动。
        版本行内的进度来自真实下载/安装回调，按钮不使用圆周动画。
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="ContentVersionRowTemplate">
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}"
                                       FontSize="12"
                                       Style="{StaticResource EmphasisText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FileNameText}"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GameVersionText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding GameVersionText}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LoaderText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LoaderText}"
                                   Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SizeText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding DateText}"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="5"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.DownloadVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanDownload}"
                                ToolTip="{Binding DownloadHint}"
                                AutomationProperties.Name="{Binding DownloadAutomationName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Width="30"
                                            Height="30"
                                            CornerRadius="15"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBorderBrush}"
                                            BorderThickness="1">
                                        <Path Data="M 8 4 L 8 12 M 5 9 L 8 12 L 11 9 M 4 15 L 12 15"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,6,0,0"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Height="3"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                         Foreground="{Binding Status, Converter={StaticResource ContentVersionStatusBrush}}"
                                         Background="{DynamicResource InputBrush}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontSize="9"
                                       Margin="8,0,0,0"
                                       Foreground="{Binding Status, Converter={StaticResource ContentVersionStatusBrush}}" />
                        </Grid>
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding ProgressText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="20,0,20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="12"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top">
                <Image Source="{Binding Hit.IconUrl}" Stretch="Uniform" Margin="4" />
            </Border>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource HeadingText}"
                           FontSize="16"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding AuthorText}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <Button Content="{Binding OpenWebsiteText}"
                        Command="{Binding OpenWebsiteCommand}"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        Margin="0,6,0,0"
                        IsEnabled="{Binding CanOpenWebsite}" />
            </StackPanel>
            <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" />
                    </Border>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding KindLabel}" FontSize="9" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding MetaText}"
                           FontSize="9"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- 简介区域高度有限：超出时只在自身区域内部滚动，不撑高弹窗。 -->
        <Border Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,12,0,0">
            <ScrollViewer MaxHeight="96"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Summary}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Border Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,10,0,0"
                Visibility="{Binding ShowModpackNote, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ModpackNote}"
                       FontSize="10"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding LoadingText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,6,0,0"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding LoadError}"
                   FontSize="10"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibility}}" />

        <!-- 有筛选：上表是匹配版本。 -->
        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding HasFilter, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FilterTitle}" Style="{StaticResource SectionText}" FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding FilterCountText}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
            <ScrollViewer MaxHeight="150"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,6,0,0">
                <ItemsControl ItemsSource="{Binding FilteredVersions}"
                              ItemTemplate="{StaticResource ContentVersionRowTemplate}" />
            </ScrollViewer>
            <TextBlock Text="{Binding FilteredEmptyText}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,0"
                       Visibility="{Binding FilteredEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 全部版本（有筛选时再次出现同一版本是预期行为）。 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding AllVersionsTitle}" Style="{StaticResource SectionText}" FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{Binding AllCountText}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
        <ScrollViewer MaxHeight="220"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,6,0,0">
            <ItemsControl ItemsSource="{Binding AllVersions}"
                          ItemTemplate="{StaticResource ContentVersionRowTemplate}" />
        </ScrollViewer>
        <TextBlock Text="{Binding AllEmptyText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,4,0,0"
                   Visibility="{Binding AllEmpty, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding IncompleteNote}"
                   FontSize="10"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding IncompleteNote, Converter={StaticResource StringToVisibility}}" />

        <Button Content="{Binding CloseText}"
                Command="{Binding CloseCommand}"
                Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0" />
    </StackPanel>
</UserControl>

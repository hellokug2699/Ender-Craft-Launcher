<UserControl x:Class="Ecl.App.Dialogs.Views.DatapackTargetDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        数据包「安装到其他位置」：先选实例，再选该实例的具体世界。
        世界条目只来自领域发现结果，不提供路径输入或任意目录目标。
    -->
    <StackPanel Margin="20,0,20,18">
        <TextBlock Text="{Binding InstanceSectionText}" Style="{StaticResource LabelText}" />
        <ListBox ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 MaxHeight="160"
                 MinHeight="60"
                 AutomationProperties.Name="{Binding InstanceSectionText}"
                 Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12"
                                   Style="{StaticResource EmphasisText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding EmptyInstancesText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}" />

        <TextBlock Text="{Binding WorldSectionText}"
                   Style="{StaticResource LabelText}"
                   Margin="0,14,0,0"
                   Visibility="{Binding HasWorlds, Converter={StaticResource BoolToVisibility}}" />
        <ListBox ItemsSource="{Binding Worlds}"
                 SelectedItem="{Binding SelectedWorld, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 MaxHeight="180"
                 MinHeight="60"
                 AutomationProperties.Name="{Binding WorldSectionText}"
                 Visibility="{Binding HasWorlds, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="12"
                                   Style="{StaticResource EmphasisText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{Binding WorldsLoadingText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding IsLoadingWorlds, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding EmptyWorldsText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding ShowNoWorlds, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding WorldErrorText}"
                   FontSize="10"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding WorldErrorText, Converter={StaticResource StringToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" />
            <Button Content="{Binding ConfirmText}"
                    Command="{Binding ConfirmCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </StackPanel>
</UserControl>

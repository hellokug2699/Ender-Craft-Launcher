<UserControl x:Class="Ecl.App.Dialogs.Views.ModpackModListDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        整合包模组预览（download-modpacks.md §8.1）：只读展示清单声明的文件，
        不提供修改清单、安装或批量操作。
    -->
    <StackPanel Margin="20,0,20,18">
        <TextBlock Text="{Binding ModpackName}"
                   Style="{StaticResource SectionText}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding CountText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,6,0,0" />
        <TextBlock Text="{Binding Hint}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="360">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="2,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding EmptyText}"
                   FontSize="10"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}" />

        <Button Content="{Binding CloseText}"
                Command="{Binding CloseCommand}"
                Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0" />
    </StackPanel>
</UserControl>

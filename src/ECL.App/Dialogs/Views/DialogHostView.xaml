<UserControl x:Class="Ecl.App.Dialogs.Views.DialogHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:dialogs="clr-namespace:Ecl.App.Dialogs"
             Focusable="False">
    <!--
        统一弹窗层（ADR 0052）：覆盖所属窗口客户区。模态时遮罩暗化全部 Shell 区域，
        并且 Shell 根节点由 IsShellInteractive 绑定禁用，保证背景不接收输入。
        这里只与 DialogEngine 的状态对象联动，不承载业务内容。

        动画分工（交接 §3.3 / §3.4）：
          - 遮罩与弹窗卡片的进入/退出由 Ecl.App.Dialogs.DialogMotion 的时序驱动；
          - 退出时卡片先完成短促淡出，再释放遮罩与宿主可见性，避免“遮罩先消失、内容悬空”；
          - 层叠切换时旧卡片保留在 ExitContent 上做交叉淡出，新卡片同时在 TopContent 淡入。
        关闭动画只影响表现层：业务结果、模态与焦点语义在 DialogEngine 中早已提交。
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="DialogCardTemplate">
            <Border Style="{StaticResource DialogCard}"
                    MinWidth="{Binding MinWidth}"
                    MaxWidth="{Binding MaxWidth}"
                    MinHeight="{Binding MinHeight}"
                    MaxHeight="{Binding MaxHeight}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏：严重级别圆点 + 标题 + 关闭入口；与内容视图共用 DialogHeaderPadding。 -->
                    <Border Padding="{StaticResource DialogHeaderPadding}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static dialogs:DialogSeverity.Information}">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static dialogs:DialogSeverity.Warning}">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static dialogs:DialogSeverity.Error}">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Style="{StaticResource DialogTitleText}"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource TabCloseButton}"
                                    Command="{Binding CloseCommand}"
                                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{loc:Loc Key=dialog.close}"
                                    AutomationProperties.Name="{loc:Loc Key=dialog.close}">
                                <Path Data="{StaticResource IconClose}"
                                      Width="10"
                                      Height="10"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ContentPresenter Content="{Binding Content}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 宿主可见性由代码管理：退出动画完成或被打断后才收起，避免动画与绑定竞态。 -->
    <Grid x:Name="Root" Visibility="Collapsed">
        <Border x:Name="Scrim"
                Background="{DynamicResource ScrimBrush}"
                Opacity="0"
                Visibility="Collapsed" />

        <!-- 层叠切换时承载被替换的旧卡片，交叉淡出后清空；不接收输入。 -->
        <ContentControl x:Name="ExitContent"
                        ContentTemplate="{StaticResource DialogCardTemplate}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Visibility="Collapsed" />

        <ContentControl x:Name="TopContent"
                        ContentTemplate="{StaticResource DialogCardTemplate}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Opacity="0" />
    </Grid>
</UserControl>

<Window x:Class="Ecl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        Title="{loc:Loc Key=app.name}"
        Icon="/ECL.ico"
        Width="1240"
        Height="800"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent launcher rail -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,24,22,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                            <Image Source="{StaticResource EclCompactIcon}" Stretch="Uniform" Margin="6" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ECL" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="ENDER CRAFT LAUNCHER"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,22,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0,12,12">
                    <TextBlock Text="NAVIGATION"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="12,0,0,7" />
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             AutomationProperties.Name="{loc:Loc Key=nav.instances}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,0,22,20">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11,9">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BuildTimeText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding BuildTimeText, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding DataDirectory}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DataDirectory}" />
                            <TextBlock Text="{Binding GameDirectory}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding GameDirectory}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content canvas -->
        <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Ellipse Grid.Row="0"
                         Width="420" Height="420"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-210,-170,0"
                         Fill="{DynamicResource AccentGlowBrush}"
                         Opacity="0.16"
                         IsHitTestVisible="False" />
                <ContentControl Grid.Row="0"
                                Content="{Binding CurrentPage}"
                                Margin="38,32,38,32" />

                <!-- 任务中心：进度、阶段、速度、ETA、停滞/重试/失败归因 -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding OperationCenter.Operations}"
                              Margin="38,0,38,18"
                              Visibility="{Binding OperationCenter.HasOperations, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StateText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding StageText}" />
                                        <Run Text="{Binding CurrentItem}" />
                                    </TextBlock>
                                    <ProgressBar Grid.Row="2"
                                                 Height="3"
                                                 Margin="0,8,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressValue}"
                                                 IsIndeterminate="{Binding IsIndeterminate}" />
                                    <Grid Grid.Row="3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SpeedText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="10,0,0,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding EtaText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="4"
                                               Text="{Binding DiagnosticText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource WarningBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>

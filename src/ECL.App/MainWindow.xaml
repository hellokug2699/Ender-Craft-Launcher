<Window x:Class="Ecl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        Title="{loc:Loc Key=app.name}"
        Icon="{StaticResource EclCompactIcon}"
        Width="1240"
        Height="800"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent launcher rail -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,24,22,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" BorderBrush="#3A2B5C" BorderThickness="1">
                            <Image Source="{StaticResource EclCompactIcon}" Stretch="Uniform" Margin="6" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ECL" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="ENDER CRAFT LAUNCHER"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,22,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0,12,12">
                    <TextBlock Text="NAVIGATION"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="12,0,0,7" />
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             AutomationProperties.Name="{loc:Loc Key=nav.instances}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,0,22,20">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="11,9">
                        <StackPanel>
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DataDirectory}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DataDirectory}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content canvas -->
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <Grid>
                <Ellipse Width="420" Height="420"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-210,-170,0"
                         Fill="{StaticResource AccentGlowBrush}"
                         Opacity="0.16"
                         IsHitTestVisible="False" />
                <ContentControl Content="{Binding SelectedNavItem.Page}"
                                Margin="38,32,38,32" />
            </Grid>
        </Border>
    </Grid>
</Window>

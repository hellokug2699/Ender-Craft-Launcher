<Window x:Class="Ecl.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="720"
        Height="480"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="28"
            Background="#070511"
            BorderBrush="#6F2AD9"
            BorderThickness="1">
        <Grid>
            <Ellipse Width="330" Height="330" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="#241044" Opacity="0.55" />
            <Ellipse Width="270" Height="270" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="#A95CFF" StrokeThickness="5" Opacity="0.75" />
            <Grid Width="150" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-48,0,0">
                <Polygon Points="18,48 48,8 104,8 134,48 124,154 26,154"
                         Fill="#08070D" Stroke="#5A1FA7" StrokeThickness="3" />
                <Rectangle Width="48" Height="13" Fill="#B75CFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="25,0,0,0" />
                <Rectangle Width="48" Height="13" Fill="#B75CFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0" />
            </Grid>
            <TextBlock Text="ECL"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,88"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="#F2E8FF"
                       TextOptions.TextRenderingMode="ClearType" />
            <TextBlock Text="ENDER CRAFT LAUNCHER"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,56"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#A98BC7"
                       CharacterSpacing="80" />
            <TextBlock Text="INITIALIZING..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,25"
                       FontSize="10"
                       Foreground="#6D597D" />
        </Grid>
    </Border>
</Window>

<UserControl x:Class="Ecl.App.Controls.SecurityStatusCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="260"
             Height="260">
    <UserControl.Resources>
        <!-- 圆内操作按钮：白色实心 + 状态色边框，保证在白色圆内可读且两侧页面样式一致。 -->
        <Style x:Key="CircleActionButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{DynamicResource OnLightTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        安全区域两页共用顶部圆形状态：白色实心、盾牌仅描边、盾牌与圆边框颜色同步。
        安全中心只显示盾牌；状态中心在盾牌内显示 ✓ / ? / X。按钮由页面提供内容与命令。
    -->
    <Grid>
        <Ellipse Width="240"
                 Height="240"
                 Fill="White"
                 Stroke="{Binding StatusBrush, ElementName=Root}"
                 StrokeThickness="3" />

        <StackPanel Width="196"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Grid Height="96">
                <Path Data="M50,4 L92,20 L92,52 C92,78 74,94 50,104 C26,94 8,78 8,52 L8,20 Z"
                      Width="76"
                      Height="86"
                      Stretch="Uniform"
                      Stroke="{Binding StatusBrush, ElementName=Root}"
                      StrokeThickness="3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding Glyph, ElementName=Root}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{Binding StatusBrush, ElementName=Root}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,2,0,0"
                           Visibility="{Binding GlyphVisibility, ElementName=Root}" />
            </Grid>

            <Button Command="{Binding SecondaryCommand, ElementName=Root}"
                    Visibility="{Binding SecondaryVisibility, ElementName=Root}"
                    Style="{StaticResource CircleActionButton}"
                    Background="White"
                    AutomationProperties.Name="{Binding SecondaryText, ElementName=Root}"
                    Margin="0,10,0,0">
                <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                           Foreground="{DynamicResource OnLightTextBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>

            <Button Command="{Binding PrimaryCommand, ElementName=Root}"
                    IsEnabled="{Binding PrimaryEnabled, ElementName=Root}"
                    Visibility="{Binding PrimaryVisibility, ElementName=Root}"
                    Style="{StaticResource CircleActionButton}"
                    Background="White"
                    AutomationProperties.Name="{Binding PrimaryText, ElementName=Root}"
                    Margin="0,8,0,0">
                <TextBlock Text="{Binding PrimaryText, ElementName=Root}"
                           Foreground="{DynamicResource OnLightTextBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

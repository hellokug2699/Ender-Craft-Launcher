<UserControl x:Class="Ecl.App.Views.InstanceDataPacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        实例工作区「内容 · 数据包」二级页（B2 收尾）。
        布局按 `hints/ui/pages/resource-library-template.md` §5/§5.1：
        先选择该实例的具体世界，顶部刷新/添加/下载；「已启用 / 未启用」两张表格，
        各自在表格内部左下角显示计数；行内字段固定为状态、名称及简介、版本范围、功能；
        拖动调整顺序或跨表启用/禁用；「应用」把启用状态与顺序写入该世界 level.dat。
        页面不拼接世界路径：世界目标来自 IDatapackService 的发现结果。
    -->
    <UserControl.Resources>
        <Style x:Key="DataPackRowToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="DataPackRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
        </Style>

        <Style x:Key="DataPackTableHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 行模板：状态 / 名称及简介 / 版本范围 / 功能（列宽与表头共用）。 -->
        <DataTemplate x:Key="DataPackRowTemplate">
            <Grid MinHeight="40" Margin="10,0" ToolTip="{Binding StatusHint}" ToolTipService.ShowDuration="60000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <controls:ContentPackStatusGlyph Kind="{Binding StatusKind}"
                                                 IconSize="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding StatusText}" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontFamily="{StaticResource UiMediumFontFamily}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxHeight="30"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding VersionRangeText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding VersionRangeText}"
                           Margin="0,0,8,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ToggleLabel}"
                            Command="{Binding DataContext.TogglePackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource DataPackRowToolButton}"
                            ToolTip="{loc:Loc Key=packs.toggleHint}"
                            AutomationProperties.Name="{Binding ToggleLabel}" />
                    <Button Content="{loc:Loc Key=common.delete}"
                            Command="{Binding DataContext.DeleteDatapackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource DataPackRowToolButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="0"
                            AutomationProperties.Name="{loc:Loc Key=datapacks.deleteTitle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!-- 世界上下文（模板 §5.1）：数据包属于具体世界，必须先选世界才能读/写。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding KindTitle}" Style="{StaticResource SectionText}" />
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding WorldLabel}" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{Binding Worlds}"
                                  SelectedItem="{Binding SelectedWorld, Mode=OneWay}"
                                  SelectionChanged="OnWorldSelectionChanged"
                                  AutomationProperties.Name="{Binding WorldLabel}"
                                  IsEnabled="{Binding HasWorlds}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding WorldHint}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="720"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <ProgressBar Height="3" IsIndeterminate="True"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding IsLoadingWorlds, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding NoWorldsText}"
                               FontSize="10"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding ShowNoWorlds, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding WorldScanWarning}"
                               FontSize="10"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding WorldScanWarning, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <!-- 顶部操作栏（模板 §2）：刷新 / 添加 xxx / 下载 xxx。 -->
                    <WrapPanel>
                        <Button Content="{loc:Loc Key=packs.action.refresh}"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource ToolbarButton}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding AddButtonText}"
                                Command="{Binding AddDatapackCommand}"
                                IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource ToolbarButton}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding DownloadButtonText}"
                                Command="{Binding DownloadDatapacksCommand}"
                                IsEnabled="{Binding CanOpenBrowser}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="{Binding DownloadHint}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding DragHint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />

                    <!-- 已启用表格（模板 §3/§5）：标题行右侧是表格外的「应用」。 -->
                    <Grid Margin="0,18,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding EnabledSectionTitle}"
                                   Style="{StaticResource SectionText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{loc:Loc Key=packs.apply}"
                                Command="{Binding ApplyCommand}"
                                MinWidth="96"
                                ToolTip="{Binding ApplyHint}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="{loc:Loc Key=packs.apply}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 窄窗口（1080×720）下列表在表格内部横向滚动，页面本身不横向溢出。 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Border MinWidth="520"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="10,7">
                                <Grid Margin="0,0,9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=packs.column.status}" Style="{StaticResource DataPackTableHeaderText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key=packs.column.name}" Style="{StaticResource DataPackTableHeaderText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Key=packs.column.version}" Style="{StaticResource DataPackTableHeaderText}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Loc Key=packs.column.tools}" Style="{StaticResource DataPackTableHeaderText}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Height="200">
                                <ListBox x:Name="EnabledList"
                                         ItemsSource="{Binding EnabledPacks}"
                                         ItemTemplate="{StaticResource DataPackRowTemplate}"
                                         ItemContainerStyle="{StaticResource DataPackRowItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AllowDrop="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="OnRowPreviewMouseLeftButtonDown"
                                         MouseMove="OnRowMouseMove"
                                         DragOver="OnTableDragOver"
                                         Drop="OnTableDrop"
                                         AutomationProperties.Name="{Binding EnabledSectionTitle}">
                                    <ListBox.Tag>enabled</ListBox.Tag>
                                </ListBox>
                                <TextBlock Text="{Binding EmptyEnabledMessage}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="24,0"
                                           Visibility="{Binding HasEnabledPacks, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding EnabledCountText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                    </ScrollViewer>

                    <!-- 未启用表格（模板 §3）：同样在表格内部左下角显示独立计数。 -->
                    <TextBlock Text="{Binding DisabledSectionTitle}"
                               Style="{StaticResource SectionText}"
                               Margin="0,18,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Border MinWidth="520"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="10,7">
                                <Grid Margin="0,0,9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=packs.column.status}" Style="{StaticResource DataPackTableHeaderText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Key=packs.column.name}" Style="{StaticResource DataPackTableHeaderText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Key=packs.column.version}" Style="{StaticResource DataPackTableHeaderText}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Loc Key=packs.column.tools}" Style="{StaticResource DataPackTableHeaderText}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Height="200">
                                <ListBox x:Name="DisabledList"
                                         ItemsSource="{Binding DisabledPacks}"
                                         ItemTemplate="{StaticResource DataPackRowTemplate}"
                                         ItemContainerStyle="{StaticResource DataPackRowItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AllowDrop="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="OnRowPreviewMouseLeftButtonDown"
                                         MouseMove="OnRowMouseMove"
                                         DragOver="OnTableDragOver"
                                         Drop="OnTableDrop"
                                         AutomationProperties.Name="{Binding DisabledSectionTitle}">
                                    <ListBox.Tag>disabled</ListBox.Tag>
                                </ListBox>
                                <TextBlock Text="{Binding EmptyDisabledMessage}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="24,0"
                                           Visibility="{Binding HasDisabledPacks, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding DisabledCountText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                    </ScrollViewer>

                    <TextBlock Text="{Binding DisabledOrderHint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding WarningText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="9"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding WarningText, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

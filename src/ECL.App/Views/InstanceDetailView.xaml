<UserControl x:Class="Ecl.App.Views.InstanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.detail.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=instance.detail.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Key=instance.detail.back}" Command="{Binding Instances.BackToInstancesCommand}" Style="{StaticResource GhostButton}" />
            </Grid>

            <Border Style="{StaticResource HeroCard}" Padding="24" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Instances.SelectedInstanceName}" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Instances.SelectedInstanceMeta}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Instances.SelectedInstanceComponents}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Instances.SelectedInstancePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Instances.SelectedInstancePath}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Key=instance.detail.launch}" Command="{Binding Instances.LaunchCommand}" Style="{StaticResource PrimaryButton}" MinWidth="132" Height="42" IsEnabled="{Binding Instances.HasSelection}" />
                        <Button Content="Dry Run" Command="{Binding Instances.DryRunCommand}" Style="{StaticResource GhostButton}" Margin="0,8,0,0" IsEnabled="{Binding Instances.HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.basic}" Style="{StaticResource SectionText}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Key=instance.detail.minecraft}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding Instances.SelectedInstance.Model.GameVersion}" FontSize="11" />
                            <TextBlock Grid.Row="1" Text="{loc:Loc Key=instance.detail.loader}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Instances.SelectedInstance.Model.Loader}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="{loc:Loc Key=instance.detail.created}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Instances.SelectedInstanceCreated}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="{loc:Loc Key=instance.detail.lastPlayed}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Instances.SelectedInstance.LastPlayedText}" FontSize="11" Margin="0,8,0,0" />
                        </Grid>
                        <Button Content="{loc:Loc Key=instance.detail.delete}" Command="{Binding Instances.DeleteInstanceCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.java}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Loc Key=instance.detail.javaDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Instances.JavaOptions}" SelectedItem="{Binding Instances.SelectedJavaOption, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="2" Content="选择 Java…" Command="{Binding Instances.BrowseJavaCommand}" Style="{StaticResource GhostButton}" />
                        </Grid>
                        <TextBlock Text="{Binding Instances.JavaStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <CheckBox Content="{loc:Loc Key=instance.detail.disableJavaCheck}" IsChecked="{Binding Instances.DisableJavaCompatibilityCheck, Mode=TwoWay}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Loc Key=instances.java.download}" Command="{Binding Instances.DownloadJavaCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{loc:Loc Key=instances.java.refresh}" Command="{Binding Instances.RefreshJavaCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.detail.jvm}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{loc:Loc Key=instance.detail.jvmDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,12" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=instance.detail.jvmPreset}" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding Instances.InstanceJvmPresetOptions}" SelectedValue="{Binding Instances.InstanceJvmPreset, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Key=instance.detail.memory}" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding Instances.InstanceMemoryMbText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="1024-65536；留空继承全局" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="预设说明" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{loc:Loc Key=instance.detail.presetNote}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Key=instance.detail.extraArgs}" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Instances.InstanceJvmArguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc Key=instance.detail.save}" Command="{Binding Instances.SaveInstanceRuntimeSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding Instances.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=instance.detail.mods}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding Mods.Summary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Key=instance.detail.importMods}" Command="{Binding Mods.ImportModsCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="{loc:Loc Key=instance.detail.refresh}" Command="{Binding Mods.RefreshCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Mods.ModSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Key=mods.searchPlaceholder}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Mods.ModFilters}" SelectedItem="{Binding Mods.SelectedModFilter, Mode=TwoWay}" DisplayMemberPath="Title" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Mods.FilteredMods}" SelectedItem="{Binding Mods.SelectedMod, Mode=TwoWay}" Height="230" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource SurfaceBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding IssuesText}" Foreground="{DynamicResource DangerBrush}" FontSize="9" TextWrapping="Wrap" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Key=mods.enableDependencies}" Command="{Binding Mods.EnableSelectedDependenciesCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=instance.detail.toggleMod}" Command="{Binding Mods.ToggleSelectedCommand}" Style="{StaticResource GhostButton}" />
                        <Button Content="{loc:Loc Key=instance.detail.deleteMod}" Command="{Binding Mods.DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=instance.detail.importModpack}" Command="{Binding Mods.ImportModpackCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=instance.detail.exportModpack}" Command="{Binding Mods.ExportModpackCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,14,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=mods.packsTitle}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Mods.PackSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Mods.PackTypes}" SelectedItem="{Binding Mods.SelectedPackType, Mode=TwoWay}" DisplayMemberPath="Title" Width="150" />
                    </Grid>
                    <TextBlock Text="{Binding Mods.PackWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding Mods.Packs}" SelectedItem="{Binding Mods.SelectedPack, Mode=TwoWay}" Height="130" Margin="0,8,0,0" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource SurfaceBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:Loc Key=mods.packImport}" Command="{Binding Mods.ImportPackCommand}" Style="{StaticResource GhostButton}" />
                        <Button Content="{loc:Loc Key=mods.packToggle}" Command="{Binding Mods.TogglePackCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=common.delete}" Command="{Binding Mods.DeletePackCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Mods.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.files}" Style="{StaticResource SectionText}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.openFolder}" Command="{Binding Instances.OpenInstanceFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.openMods}" Command="{Binding Instances.OpenModsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.logs}" Style="{StaticResource SectionText}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.exportLog}" Command="{Binding Instances.ExportLatestLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.analyzeCrash}" Command="{Binding Instances.AnalyzeCrashCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.exportDiagnostics}" Command="{Binding Instances.ExportDiagnosticsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Instances.CrashAnalysisText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Instances.DiagnosticStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.detail.latestLaunch}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding Instances.LaunchStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Instances.LaunchSteps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource LaunchStatusBrush}}" FontSize="10" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Key=instance.detail.commandPreview}" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Instances.LaunchCommandPreview, Mode=OneWay}" Height="72" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

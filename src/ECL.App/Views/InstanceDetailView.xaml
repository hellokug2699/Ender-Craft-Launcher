<UserControl x:Class="Ecl.App.Views.InstanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <UserControl.Resources>
        <Style x:Key="InstanceNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource CompactNavItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding UnavailableReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 窄窗口下页面选择器的条目：同样用禁用态与文字徽标表达不可用，不只靠颜色。 -->
        <Style x:Key="InstanceNavComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding UnavailableReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        实例工作区（B2 步骤 2）：左侧二级导航 + 右侧当前二级页。
        分组、顺序与默认页严格对应 `hints/ui/pages/instance-workspace.md` §10；
        未实现的页面只在导航中保留准确的不可用状态，不创建空页。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="176"
                Padding="0,0,14,0"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="2,0,0,14">
                    <TextBlock Text="{Binding InstanceName}"
                               Style="{StaticResource EmphasisText}"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding InstanceName}" />
                    <TextBlock Text="{Binding InstanceMeta}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding InstanceMeta}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Navigation.ItemsView}"
                         SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource InstanceNavItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Loc Key=instance.nav.title}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           AutomationProperties.Name="{Binding Title}" />
                                <!-- 未实现的页面用文字徽标表达不可用状态，不只靠颜色。 -->
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Key=instance.nav.unavailable.badge}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               Style="{StaticResource EmphasisText}"
                                               Margin="10,10,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 每个二级页只拥有自己的一个滚动容器；切换到其它二级页不改变工作区标题。 -->
        <Grid Grid.Column="1" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 窄窗口（<640）下用页面选择器替代左侧导航，避免内容区被压缩到不可用。 -->
            <ComboBox Grid.Row="0"
                      ItemsSource="{Binding Navigation.Items}"
                      SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource InstanceNavComboItemStyle}"
                      Margin="0,0,0,10"
                      AutomationProperties.Name="{loc:Loc Key=instance.nav.title}"
                      Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToVisibility}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="12" />
                                <TextBlock Text="{Binding GroupTitle}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{loc:Loc Key=instance.nav.unavailable.badge}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ContentControl Grid.Row="1"
                            Content="{Binding Navigation.CurrentPage}"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Ecl.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <!-- 实例页只有一个滚动容器；页面不再叠加外边距，外围边距由 PageHost 提供。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!--
                页面顶部（instances.md §2.2）：三个主要操作固定顺序「添加MC目录 → 导入整合包 → 刷新」，
                「导入已安装版本」作为次级操作保留，不与整合包导入混用。
                原来的“实例库只负责展示…不在这里修改运行设置”声明已按 §2.1 删除。
            -->
            <controls:PageHeader Title="{loc:Loc Key=instances.title}"
                                 Subtitle="{loc:Loc Key=instances.subtitle}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc Key=instances.addDirectory}"
                                Command="{Binding AddDirectoryCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=instances.importModpack}"
                                Command="{Binding ImportModpackCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=common.refresh}"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=instances.importButton}"
                                Command="{Binding ImportVersionsCommand}"
                                Style="{StaticResource ToolbarButton}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- 辅助状态行：导入/删除结果与来源扫描原因；不是空态文案。 -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

            <!-- 加载态：读取实例列表时只显示加载说明，不显示“空”。 -->
            <controls:PageStateView State="Loading"
                                    Margin="0,40,0,40"
                                    Visibility="{Binding ShowLoadingState, Converter={StaticResource BoolToVisibility}}" />

            <!-- 错误态：说明发生了什么并提供重试。 -->
            <controls:PageStateView State="Error"
                                    Description="{Binding InstanceLoadError}"
                                    Margin="0,40,0,40"
                                    Visibility="{Binding ShowErrorState, Converter={StaticResource BoolToVisibility}}">
                <controls:PageStateView.ActionContent>
                    <Button Content="{loc:Loc Key=instances.loadRetry}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}" />
                </controls:PageStateView.ActionContent>
            </controls:PageStateView>

            <!-- 空态：说明为什么空，并给出可执行的第一步。 -->
            <controls:PageStateView State="Empty"
                                    Description="{loc:Loc Key=instances.emptyActionHint}"
                                    Margin="0,40,0,40"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <controls:PageStateView.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Key=instances.addDirectory}"
                                Command="{Binding AddDirectoryCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=instances.importButton}"
                                Command="{Binding ImportVersionsCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </controls:PageStateView.ActionContent>
            </controls:PageStateView>

            <Grid Margin="0,0,0,10" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Key=instances.listTitle}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1" Text="{Binding InstanceCountText}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>

            <!-- 实例卡片：每行两个；左侧信息、右侧两个纵向操作（instances.md §3）。 -->
            <ListBox x:Name="InstanceList"
                     ItemsSource="{Binding Instances}"
                     SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource InstanceItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0,0,0,18"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                     MouseDoubleClick="OnInstanceDoubleClick">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" Margin="0,0,10,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!-- 第一行：实例名 + 加载器（加载器按类型着色，文字仍保留）。 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   Style="{StaticResource EmphasisText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LoaderText}"
                                                   Foreground="{Binding LoaderKind, Converter={StaticResource LoaderKindBrush}}"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- 第二行：实例存放路径（完整路径，超出截断但保留提示）。 -->
                                    <TextBlock Text="{Binding PathText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PathText}" />
                                    <!-- 第三行：创建日期。 -->
                                    <TextBlock Text="{Binding CreatedText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0" />
                                    <!-- 第四行：最后游玩日期；从未游玩时明确显示“从未游玩”。 -->
                                    <TextBlock Text="{Binding LastPlayedText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="{loc:Loc Key=instances.openWorkspace}"
                                            Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}" />
                                    <Button Content="{loc:Loc Key=instances.deleteInstance}"
                                            Command="{Binding DataContext.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 来源分组：保留现状，仅补本地化；不因扫描失败删除实例记录。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"
                    Visibility="{Binding HasSourceGroups, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.sources.title}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{loc:Loc Key=instances.sources.hint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,5,0,10"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SourceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Background="{DynamicResource SurfaceAltBrush}"
                                          BorderBrush="{DynamicResource BorderSoftBrush}"
                                          BorderThickness="1"
                                          Margin="0,0,0,8"
                                          Padding="4">
                                    <Expander.Header>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="9" VerticalAlignment="Center" Margin="10,0,8,0" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Instances}" Margin="8,4,8,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" />
                                                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Availability}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Loc Key=instances.createMovedHint}" Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

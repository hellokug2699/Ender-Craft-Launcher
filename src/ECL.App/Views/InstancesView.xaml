<UserControl x:Class="Ecl.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=instances.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Key=common.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
            </Grid>
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,18" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instances.launch}" Style="{StaticResource LabelText}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding SelectedInstanceName}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{loc:Loc Key=instances.empty}" FontSize="22" FontWeight="SemiBold" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectedInstanceMeta}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SelectedInstanceComponents}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="打开实例工作区" Command="{Binding OpenInstanceDetailsCommand}" Style="{StaticResource GhostButton}" MinWidth="128" Height="38" IsEnabled="{Binding HasSelection}" Margin="0,0,0,8" />
                        <Button Content="{loc:Loc Key=instances.launch}" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" MinWidth="128" Height="42" IsEnabled="{Binding HasSelection}" />
                        <TextBlock Text="{loc:Loc Key=instances.installMovedHint}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   MaxWidth="150"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Key=instances.listTitle}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{loc:Loc Key=instances.empty}" Style="{StaticResource SubtitleText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14" />
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=TwoWay}" ItemContainerStyle="{StaticResource InstanceItemStyle}" BorderThickness="0" Background="Transparent" Margin="0,0,0,18">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,0,10,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="{Binding VersionText}" /></Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,0,0,18">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:Loc Key=instances.launch}" Style="{StaticResource SectionText}" /><TextBlock Text="{Binding SelectedInstanceCreated}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{loc:Loc Key=instances.dryRun}" Command="{Binding DryRunCommand}" Style="{StaticResource GhostButton}" /><Button Content="{loc:Loc Key=common.delete}" Command="{Binding DeleteInstanceCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" /></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedInstancePath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedInstancePath}" />
                    <TextBlock Text="{Binding LaunchStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding LaunchSteps}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource LaunchStatusBrush}}" FontSize="10" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Key=instances.command}" Style="{StaticResource LabelText}" Margin="0,14,0,6" /><TextBox Style="{StaticResource MonoTextBox}" Text="{Binding LaunchCommandPreview, Mode=OneWay}" Height="90" />
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Loc Key=instances.createMovedHint}" Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.accountTitle}" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" ItemTemplate="{StaticResource DisplayNameItemTemplate}" /><TextBox Grid.Column="2" Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Key=instances.accountNamePlaceholder}" /></Grid>
                    <Button Content="{loc:Loc Key=instances.addAccount}" Command="{Binding AddAccountCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" /><TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.java.title}" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJavaOption, Mode=TwoWay}" ItemTemplate="{StaticResource DisplayNameItemTemplate}" IsEnabled="{Binding HasSelection}" /><Button Grid.Column="2" Content="选择 Java…" Command="{Binding BrowseJavaCommand}" Style="{StaticResource GhostButton}" IsEnabled="{Binding HasSelection}" /></Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Key=instances.java.download}" Command="{Binding DownloadJavaCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasSelection}" />
                        <Button Content="{loc:Loc Key=instances.java.refresh}" Command="{Binding RefreshJavaCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}" />
                    </StackPanel><CheckBox Content="{loc:Loc Key=option.instance.disableJavaCheck.name}" IsChecked="{Binding DisableJavaCompatibilityCheck, Mode=TwoWay}" IsEnabled="{Binding HasSelection}" Margin="0,12,0,0" /><TextBlock Text="{Binding JavaStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" /><ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding JavaDownloadProgressValue}" IsIndeterminate="{Binding JavaDownloadIndeterminate}" Visibility="{Binding IsDownloadingJava, Converter={StaticResource BoolToVisibility}}" /><TextBlock Text="{Binding JavaDownloadStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CanPauseDownload, Converter={StaticResource BoolToVisibility}}"><Button Content="{Binding DownloadPauseButtonText}" Command="{Binding ToggleDownloadPauseCommand}" Style="{StaticResource GhostButton}" /><TextBlock Text="{Binding DownloadSpeedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                </StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="实例独立运行设置" Style="{StaticResource SectionText}" />
                    <TextBlock Text="以下设置只对当前选中的实例生效；留空表示继承启动器全局设置。"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="独立 JVM 参数" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding InstanceJvmArguments, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonoTextBox}" MinHeight="72" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="-XX:+UseG1GC -XX:MaxGCPauseMillis=50" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="实例最大内存（MB）" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding InstanceMemoryMbText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"
                                     ToolTip="1024-65536；留空继承全局设置" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="保存运行设置"
                                Command="{Binding SaveInstanceRuntimeSettingsCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16,0,12" />
                    <TextBlock Text="实例快捷操作" Style="{StaticResource LabelText}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="打开实例文件夹" Command="{Binding OpenInstanceFolderCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        <Button Content="打开 Mods 文件夹" Command="{Binding OpenModsFolderCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        <Button Content="管理此实例的模组" Command="{Binding ManageInstanceModsCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        <Button Content="导出最近一次运行日志" Command="{Binding ExportLatestLogCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"><StackPanel>
                <TextBlock Text="{loc:Loc Key=diagnostics.title}" Style="{StaticResource SectionText}" /><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="{loc:Loc Key=diagnostics.analyze}" Command="{Binding AnalyzeCrashCommand}" Style="{StaticResource GhostButton}" /><Button Content="{loc:Loc Key=diagnostics.export}" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" /></StackPanel><ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsAnalyzingCrash, Converter={StaticResource BoolToVisibility}}" /><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBlock Text="{Binding CrashAnalysisText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" /></ScrollViewer><TextBlock Text="{Binding DiagnosticStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

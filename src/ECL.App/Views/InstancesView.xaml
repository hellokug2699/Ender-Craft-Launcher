<UserControl x:Class="Ecl.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Cycle"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=instances.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Key=common.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Top" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{loc:Loc Key=instances.libraryHint}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc Key=instances.openWorkspaceHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="260" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:Loc Key=instances.importButton}" Command="{Binding ImportVersionsCommand}" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Key=instances.listTitle}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1" Text="{Binding InstanceCountText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{loc:Loc Key=instances.empty}" Style="{StaticResource SubtitleText}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,14" />

            <ListBox x:Name="InstanceList"
                     ItemsSource="{Binding Instances}"
                     SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource InstanceItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     Margin="0,0,0,18"
                     MouseDoubleClick="OnInstanceDoubleClick">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" Margin="0,0,10,10">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" Style="{StaticResource EmphasisText}" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MinecraftVersionText}" FontSize="10" Foreground="{DynamicResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="0">
                                            <TextBlock Text="{Binding LoaderText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LastPlayedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding PathText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="9"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PathText}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{loc:Loc Key=instances.openWorkspace}"
                                        Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{loc:Loc Key=instances.createMovedHint}" Style="{StaticResource SubtitleText}" Margin="0,0,0,14" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Ecl.App.Views.InstanceModifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:wsvm="clr-namespace:Ecl.App.Workspace.ViewModels"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        实例工作区「配置 · 修改」二级页（B2 步骤 3b-4a）。
        布局按 `hints/ui/pages/instance-modify.md`：当前值↔拟变更值、只读变更计划与影响预览、
        页面底部操作。本步骤只生成只读计划，不写实例、不创建快照、不下载产物。
        页面只有一个纵向滚动容器；计划条目数量由固定检查项决定（有界），不使用无上限列表。
    -->
    <UserControl.Resources>
        <Style x:Key="ModifyValueText" TargetType="TextBlock">            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModifyRowLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            下拉条目使用 DisplayName 作为 UIA 名称：记录类型的默认 ToString() 会把整个对象
            投影暴露给屏幕阅读器和自动化，不可作为可访问名称。
        -->
        <Style x:Key="ModifyChoiceItemStyle" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>

        <Style x:Key="ModifyPlanImpactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Impact}" Value="{x:Static wsvm:ModifyPlanImpact.Certain}">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="{x:Static wsvm:ModifyPlanImpact.Possible}">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Impact}" Value="{x:Static wsvm:ModifyPlanImpact.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 需要处理 / 不可执行原因的条目：用左侧色条 + 文字表达，不只靠颜色。 -->
        <DataTemplate x:Key="ModifyReasonTemplate">
            <Border Padding="8,3,0,3" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!-- 目标实例在整个流程中固定：名称、当前版本/加载器与目录只读呈现。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding InstanceName}"
                               FontSize="18"
                               Style="{StaticResource EmphasisText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InstanceMeta}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{loc:Loc Key=instance.modify.fixedTargetNote}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentPath}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentPath}" />
                </StackPanel>
            </Border>

            <!-- 可变更项：每行左侧是当前值，右侧是拟变更值，两者不会混在一起。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.modify.section.target}"
                               Style="{StaticResource EmphasisText}"
                               FontSize="13" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc Key=instance.modify.column.current}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Column="3"
                                   Text="{loc:Loc Key=instance.modify.column.target}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,0,0,6" />

                        <!-- Minecraft 版本 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{loc:Loc Key=instance.modify.item.version}"
                                   Style="{StaticResource ModifyRowLabel}"
                                   Margin="0,0,10,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding CurrentVersionText}"
                                   Style="{StaticResource ModifyValueText}"
                                   Margin="0,0,0,8" />
                        <ComboBox Grid.Row="1" Grid.Column="3"
                                  ItemsSource="{Binding TargetVersions}"
                                  SelectedItem="{Binding SelectedTargetVersion, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                  ItemContainerStyle="{StaticResource ModifyChoiceItemStyle}"
                                  AutomationProperties.Name="{loc:Loc Key=instance.modify.item.version}"
                                  Margin="0,0,0,8" />

                        <!-- 加载器 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{loc:Loc Key=instance.modify.item.loader}"
                                   Style="{StaticResource ModifyRowLabel}"
                                   Margin="0,0,10,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding CurrentLoaderText}"
                                   Style="{StaticResource ModifyValueText}"
                                   Margin="0,0,0,8" />
                        <ComboBox Grid.Row="2" Grid.Column="3"
                                  ItemsSource="{Binding LoaderChoices}"
                                  SelectedItem="{Binding SelectedTargetLoader, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                  ItemContainerStyle="{StaticResource ModifyChoiceItemStyle}"
                                  AutomationProperties.Name="{loc:Loc Key=instance.modify.item.loader}"
                                  Margin="0,0,0,8" />

                        <!-- 加载器版本（原版不需要） -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{loc:Loc Key=instance.modify.item.loaderVersion}"
                                   Style="{StaticResource ModifyRowLabel}"
                                   Margin="0,0,10,8"
                                   Visibility="{Binding IsLoaderVersionRequired, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding CurrentLoaderVersionText}"
                                   Style="{StaticResource ModifyValueText}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsLoaderVersionRequired, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Grid.Row="3" Grid.Column="3"
                                  ItemsSource="{Binding LoaderVersions}"
                                  SelectedItem="{Binding SelectedTargetLoaderVersion, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                  ItemContainerStyle="{StaticResource ModifyChoiceItemStyle}"
                                  AutomationProperties.Name="{loc:Loc Key=instance.modify.item.loaderVersion}"
                                  Margin="0,0,0,8"
                                  Visibility="{Binding IsLoaderVersionRequired, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 附加组件（含 OptiFine 显式选择） -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{loc:Loc Key=instance.modify.item.components}"
                                   Style="{StaticResource ModifyRowLabel}"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding CurrentComponentsText}"
                                   Style="{StaticResource ModifyValueText}" />
                        <StackPanel Grid.Row="4" Grid.Column="3">
                            <TextBlock Text="{Binding TargetComponentsText}"
                                       Style="{StaticResource ModifyValueText}" />
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding IsOptiFineTarget, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=instance.modify.target.optiFine}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding OptiFineVersions}"
                                          SelectedItem="{Binding SelectedTargetOptiFine, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                          ItemContainerStyle="{StaticResource ModifyChoiceItemStyle}"
                                          AutomationProperties.Name="{loc:Loc Key=instance.modify.target.optiFine}" />
                                <TextBlock Text="{Binding OptiFineNote}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="9"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasOptiFineNote, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 目标组合的真实说明：Cleanroom 过滤、Fabric API、读取状态。 -->
                    <TextBlock Text="{Binding LoaderFilterNote}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasLoaderFilterNote, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding FabricApiText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="9"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFabricApiNote, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding TargetStatus}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasTargetStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 状态与只读计划：状态用文字 + 颜色双重表达，不只靠颜色。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Border Padding="12,10" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlanState}" Value="{x:Static wsvm:InstanceModifyPlanState.Executable}">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlanState}" Value="{x:Static wsvm:InstanceModifyPlanState.NeedsAction}">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PlanState}" Value="{x:Static wsvm:InstanceModifyPlanState.NotExecutable}">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PlanStateText}"
                                       Style="{StaticResource EmphasisText}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding PlanStateDetail}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 不可执行原因 -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Key=instance.modify.section.blockers}"
                                   Style="{StaticResource EmphasisText}"
                                   FontSize="11"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Blockers}"
                                      ItemTemplate="{StaticResource ModifyReasonTemplate}" />
                    </StackPanel>

                    <!-- 需要处理的项 -->
                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding HasActionItems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Key=instance.modify.section.actions}"
                                   Style="{StaticResource EmphasisText}"
                                   FontSize="11"
                                   Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding ActionItems}"
                                      ItemTemplate="{StaticResource ModifyReasonTemplate}" />
                    </StackPanel>

                    <!-- 变更计划与影响预览：条目数量由固定检查项决定，有界。 -->
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc Key=instance.modify.section.plan}"
                                   Style="{StaticResource EmphasisText}"
                                   FontSize="11"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{loc:Loc Key=instance.modify.section.planEmpty}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasPlan, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding PlanItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ImpactText}"
                                                       Style="{StaticResource ModifyPlanImpactText}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource EmphasisText}"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="10"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 页面底部操作：只提供「生成变更计划」；提交与执行属 3b-4b，能力接入前不放置可执行入口。 -->
            <WrapPanel Margin="0,0,0,4">
                <Button Content="{loc:Loc Key=instance.modify.action.generate}"
                        Command="{Binding GeneratePlanCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="132"
                        Margin="0,0,12,8" />
                <TextBlock Text="{loc:Loc Key=instance.modify.action.futureNote}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="9"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Ecl.App.Views.ContentDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <!--
        下载中心内容发现页（模组 / 整合包 / 资源包 / 光影包 / 数据包共用模板）。
        第一行是搜索与来源，第二行是目标实例与适用性筛选，下面是内容列表；
        详情、目标确认与条级进度都由页面状态与统一弹窗承载，不在视图里做业务判断。
    -->
    <StackPanel>
        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}" />
            <TextBlock Text="{Binding Subtitle}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <!-- 能力未接入的分类（当前为数据包）如实显示原因，不放伪入口。 -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="13" Style="{StaticResource EmphasisText}" />
                <TextBlock Text="{Binding UnavailableReason}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding IsUnavailable, Converter={StaticResource InverseBoolToVisibility}}">
            <!-- ==================== 第一行：搜索 ==================== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="11" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchInputInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding SearchPlaceholder}"
                                     AutomationProperties.Name="{Binding SearchPlaceholder}" />
                        </Border>
                        <Button Grid.Column="2"
                                Content="{Binding SearchText}"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding CanSearch}" />
                    </Grid>
                    <TextBlock Text="{Binding EnglishOnlyHint}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchInputInvalid}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 来源切换：全部 / CurseForge / Modrinth（不跨来源合并）。 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SourceLabel}"
                                   Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <ListBox ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PillItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="{Binding SourceLabel}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="10"
                                               Style="{StaticResource EmphasisText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- ==================== 第二行：目标与筛选 ==================== -->
                    <CheckBox Content="{Binding ExistingInstanceModeText}"
                              IsChecked="{Binding UseExistingInstance, Mode=TwoWay}"
                              Margin="0,12,0,0"
                              Visibility="{Binding ShowsTargetModeCheckBox, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding ShowsInstanceSelector, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding TargetInstanceLabel}" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding TargetInstances}"
                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource NameItemTemplate}"
                                      AutomationProperties.Name="{Binding TargetInstanceLabel}"
                                      IsEnabled="{Binding HasInstances}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding InstanceHint}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,6" />
                    </Grid>

                    <TextBlock Text="{Binding NoInstancesText}"
                               FontSize="10"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding ShowNoInstances, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding ShowsCustomFilters, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding GameVersionLabel}" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding GameVersions}"
                                      SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                      AutomationProperties.Name="{Binding GameVersionLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding LoaderChoices}"
                                      SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource TitleItemTemplate}"
                                      AutomationProperties.Name="{Binding LoaderLabel}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding InstanceHint}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding ShowsCustomFilters, Converter={StaticResource BoolToVisibility}}" />

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,10,0,0"
                            Visibility="{Binding ShowsShaderSupport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ShaderSupportNote}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 结果 ==================== -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360" />
            </Grid>
            <ProgressBar Height="3" IsIndeterminate="True"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding SearchWarnings}"
                       Foreground="{DynamicResource WarningBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding SearchWarnings, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Text="{Binding ListHint}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,4,0,8"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ResourceRowButton}"
                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding IconUrl}" Stretch="Uniform" Margin="3" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               Style="{StaticResource EmphasisText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Key=downloads.discovery.columns.versionRange}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding VersionRangeText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding VersionRangeText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                            Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{loc:Loc Key=downloads.discovery.columns.loader}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding LoaderText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LoaderText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Key=downloads.discovery.columns.source}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="9">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsModrinth}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Key=downloads.discovery.columns.size}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SizeText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding EmptyResultText}"
                               FontSize="12"
                               Style="{StaticResource EmphasisText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>

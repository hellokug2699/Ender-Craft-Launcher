<UserControl x:Class="Ecl.App.Views.LogSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <Style x:Key="LogSessionItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <Style x:Key="LogLineItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Raw}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <!-- 搜索命中与当前命中使用不同状态，互不覆盖级别颜色。 -->
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrentMatch}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日志正文的等宽只读输入：允许行内选择与复制，不改变原始文本。 -->
        <Style x:Key="LogLineTextStyle" TargetType="TextBox" BasedOn="{StaticResource MonoTextBox}">
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <Style x:Key="LogSourceTabStyle" TargetType="ListBoxItem" BasedOn="{StaticResource TabStripItemStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <!--
            阅读器工具栏：与来源页签同一行，按钮按“紧凑但仍可点”的密度排版。
            辅助操作收进“更多”，避免工具栏自己再占一行（正文高度优先）。
        -->
        <Style x:Key="ReaderToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReaderToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource PanelToggleButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LogListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <!--
                阅读器按来源分段读取并限制为最近 N 行；长列表必须使用有效虚拟化，
                只创建可见区附近的容器。切换来源时通过清空集合（Reset）重建，
                而不是关闭虚拟化来规避容器复用问题（logs.md §3.4、§9）。
            -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="LogScroller"
                                          Focusable="False"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AutoWrap}" Value="True">
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <controls:PageHeader Title="{Binding Title}" Subtitle="{Binding PageSubtitle}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Key=logs.refreshSessions}"
                                Command="{Binding RefreshSessionsCommand}"
                                Style="{StaticResource ToolbarButton}" />
                        <Button Content="{Binding ExportText}"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- 目标会话不可用（logs.md §7.1）：保留说明，不静默改看其它会话。 -->
            <Border Margin="24,0,24,8"
                    Padding="10,6"
                    CornerRadius="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasTargetUnavailable, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding TargetUnavailableMessage}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 实例快捷入口的筛选上下文（logs.md §7.2）。 -->
            <Border Margin="24,0,24,8"
                    Padding="10,6"
                    CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasInstanceFocus, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding InstanceFocusMessage}"
                               FontSize="10"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Key=logs.filter.clearInstance}"
                            Command="{Binding ClearInstanceFocusCommand}"
                            Style="{StaticResource ToolbarButton}"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧会话栏：可按用户或窄窗口折叠。 -->
            <Border Padding="0"
                    Visibility="{Binding IsSessionListOpen, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Width" Value="260" />
                        <Style.Triggers>
                            <!-- 窄窗口：会话栏作为覆盖层打开，不把中央日志正文压到不可读。 -->
                            <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Panel.ZIndex" Value="3" />
                                <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,10,12,4">
                        <TextBlock Text="{loc:Loc Key=logs.sessions}"
                                   Style="{StaticResource SectionText}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sessions.Count}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <Button Content="{loc:Loc Key=logs.sessionList.hide}"
                                    Command="{Binding ToggleSessionListCommand}"
                                    Style="{StaticResource ToolbarButton}"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsNarrow, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="12,0,12,8">
                        <ComboBox ItemsSource="{Binding InstanceFilterOptions}"
                                  SelectedItem="{Binding SelectedInstanceFilter, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc Key=logs.filter.instance}"
                                  Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding StateFilterOptions}"
                                      SelectedItem="{Binding SelectedStateFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Loc Key=logs.filter.state}" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding TimeFilterOptions}"
                                      SelectedItem="{Binding SelectedTimeFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Loc Key=logs.filter.time}" />
                        </Grid>
                        <TextBox Text="{Binding MetadataSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0"
                                 AutomationProperties.Name="{loc:Loc Key=logs.filter.sessionSearch}"
                                 ToolTip="{loc:Loc Key=logs.filter.sessionSearch}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="SessionList"
                                 ItemsSource="{Binding SessionsView}"
                                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource LogSessionItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,5">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding StateText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource AccentHoverBrush}" />
                                            <TextBlock Text="{Binding PidText}"
                                                       FontSize="10"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StartedText}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding EvidenceHint}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasEvidenceHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10"
                                                       Style="{StaticResource EmphasisText}"
                                                       Margin="10,10,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Key=logs.context.copySessionId}"
                                              Command="{Binding PlacementTarget.DataContext.CopySessionIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Loc Key=logs.openFolder}"
                                              Command="{Binding PlacementTarget.DataContext.OpenSessionFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Loc Key=logs.export}"
                                              Command="{Binding PlacementTarget.DataContext.ExportSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <TextBlock Text="{Binding EmptySessionsText}"
                                   Margin="14,10"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding ShowSessionSplitter, Converter={StaticResource BoolToVisibility}}" />

            <!--
                中央阅读区：正文是主体。来源页签与阅读器操作共用一行，
                搜索/过滤改为浮层，证据清单改为右侧栏——三者都不再占用正文上方的垂直空间。
            -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题行：当前会话身份。 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSession.Title, TargetNullValue={x:Null}}"
                                   Style="{StaticResource SectionText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SessionSummary}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Loc Key=logs.sessionList.toggle}"
                            Command="{Binding ToggleSessionListCommand}"
                            Style="{StaticResource ReaderToolButton}"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0" />
                </Grid>

                <!-- 来源选择与阅读器操作同一行。 -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 来源切换：游戏日志 / stdout / stderr / 诊断证据 -->
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Sources}"
                             SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource LogSourceTabStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{loc:Loc Key=logs.sources}"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsCompactSources, Converter={StaticResource InverseBoolToVisibility}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 来源页签保持一行：警告只以提示点表达，完整说明在 ToolTip 与选中后的提示条里。 -->
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Warning}">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="6,0,0,0"
                                             Fill="{DynamicResource WarningBrush}"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding Warning, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="9"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="140" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 窄窗口用单行来源选择器替代页签。 -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                              VerticalAlignment="Top"
                              AutomationProperties.Name="{loc:Loc Key=logs.sources}"
                              Visibility="{Binding IsCompactSources, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontSize="11" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 阅读器操作：只保留高频动作，其余收进“更多”。 -->
                    <WrapPanel Grid.Column="1"
                               Orientation="Horizontal"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="6,0,0,0">
                        <Button Content="{Binding FollowText}"
                                Command="{Binding ToggleFollowCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                ToolTip="{loc:Loc Key=logs.follow.hint}" />
                        <Button Content="{Binding WrapText}"
                                Command="{Binding ToggleWrapCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                ToolTip="{loc:Loc Key=logs.wrap.hint}" />
                        <Button Content="{Binding CopySelectedText}"
                                Command="{Binding CopyLinesCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                ToolTip="{loc:Loc Key=logs.selectionHint}"
                                IsEnabled="{Binding HasSelection}" />
                        <ToggleButton IsChecked="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                                      Style="{StaticResource ReaderToggleButton}"
                                      ToolTip="{loc:Loc Key=logs.searchAndFilter}"
                                      AutomationProperties.Name="{loc:Loc Key=logs.searchAndFilter}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFilter}"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.3"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Key=logs.filter.short}"
                                           Margin="5,0,0,0"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="ReaderMoreButton"
                                Content="{loc:Loc Key=logs.moreActions}"
                                Click="OnReaderMoreClick"
                                Style="{StaticResource ReaderToolButton}"
                                AutomationProperties.Name="{loc:Loc Key=logs.moreActions}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc Key=logs.copyLine}"
                                              Command="{Binding PlacementTarget.DataContext.CopyLineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext.SelectedLine, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Loc Key=logs.copyVisible}"
                                              Command="{Binding PlacementTarget.DataContext.CopyVisibleLinesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator Style="{StaticResource MenuSeparator}" />
                                    <MenuItem Header="{Binding PlacementTarget.DataContext.AutoOpenText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.DataContext.ToggleAutoOpenOnFailureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="{loc:Loc Key=logs.openFolder}"
                                              Command="{Binding PlacementTarget.DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                </Grid>

                <!-- 来源歧义/错误提示 -->
                <Border Grid.Row="2"
                        Margin="0,0,0,6"
                        Padding="10,5"
                        CornerRadius="8"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasSourceWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SourceWarning}"
                               FontSize="10"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 正文 + 证据侧栏 + 搜索浮层。 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 日志正文：中央主体，虚拟化列表 + 等宽只读文本。 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" MinHeight="160">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox x:Name="LogList"
                                     SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnLogListSelectionChanged"
                                     ItemContainerStyle="{StaticResource LogLineItemStyle}"
                                     Style="{StaticResource LogListStyle}"
                                     AutomationProperties.Name="{loc:Loc Key=logs.reader.title}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,1,8,1" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimestampText}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,1,6,1" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LevelText}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="10"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                                                       Margin="0,1,4,1" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding Message, Mode=OneWay}"
                                                     ToolTip="{Binding Raw}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource LogLineTextStyle}">
                                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.AutoWrap, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding EmptyLinesText}"
                                       Margin="18"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 暂停跟随后有新内容时提示；点击恢复跟随并回到最新行。 -->
                            <Button Content="{loc:Loc Key=logs.newLines}"
                                    Command="{Binding ToggleFollowCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasNewLines, Converter={StaticResource BoolToVisibility}}" />

                            <ProgressBar IsIndeterminate="True"
                                         Height="2"
                                         VerticalAlignment="Bottom"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>

                    <!--
                        诊断证据清单：右侧栏。证据条目与预览入口在这里常驻，
                        不再压在正文上方（原先最多占 180px 高度）。
                    -->
                    <Border Grid.Column="1"
                            Padding="0"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsEvidenceSource, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Width" Value="248" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                        <Setter Property="Width" Value="196" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="12,9,12,4">
                                <TextBlock Text="{loc:Loc Key=logs.evidence.title}"
                                           Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding Evidence.Count}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Evidence}"
                                     SelectedItem="{Binding SelectedEvidence, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding KindText}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KindText}"
                                                           FontSize="11"
                                                           Style="{StaticResource EmphasisText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OwnershipText}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding WarningText}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="{loc:Loc Key=logs.evidence.previewButton}"
                                                    Command="{Binding DataContext.PreviewEvidenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ReaderToolButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!--
                        搜索与过滤浮层：默认收起，展开时浮在正文之上，不改变正文高度。
                    -->
                    <Border Grid.Column="0"
                            Panel.ZIndex="4"
                            Width="460"
                            MaxHeight="420"
                            Margin="0,6,8,0"
                            Padding="12,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{loc:Loc Key=logs.searchAndFilter}"
                                           Style="{StaticResource EmphasisText}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                                              Style="{StaticResource ReaderToggleButton}"
                                              Margin="0"
                                              AutomationProperties.Name="{loc:Loc Key=logs.filter.close}"
                                              ToolTip="{loc:Loc Key=logs.filter.close}">
                                    <Path Data="{StaticResource IconClose}"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.4"
                                          Width="10"
                                          Height="10"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                </ToggleButton>

                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Loc Key=logs.search.label}"
                                             ToolTip="{loc:Loc Key=logs.search.label}"
                                             Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SearchStatus}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="150" />
                                </Grid>

                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <CheckBox Content="{loc:Loc Key=logs.search.caseSensitive}"
                                              IsChecked="{Binding SearchCaseSensitive, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.search.regex}"
                                              IsChecked="{Binding SearchUseRegex, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,6" />
                                    <Button Content="{loc:Loc Key=logs.search.apply}"
                                            Command="{Binding SearchCommand}"
                                            Style="{StaticResource ReaderToolButton}"
                                            Margin="0,0,4,6" />
                                    <Button Content="{loc:Loc Key=logs.search.previous}"
                                            Command="{Binding PreviousMatchCommand}"
                                            Style="{StaticResource ReaderToolButton}"
                                            Margin="0,0,4,6" />
                                    <Button Content="{loc:Loc Key=logs.search.next}"
                                            Command="{Binding NextMatchCommand}"
                                            Style="{StaticResource ReaderToolButton}"
                                            Margin="0,0,0,6" />
                                </WrapPanel>

                                <Border Grid.Row="3" Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="{DynamicResource BorderSoftBrush}"
                                        Margin="0,2,0,6" />

                                <WrapPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <CheckBox Content="{loc:Loc Key=logs.level.trace}"
                                              IsChecked="{Binding FilterTrace, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.level.debug}"
                                              IsChecked="{Binding FilterDebug, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.level.info}"
                                              IsChecked="{Binding FilterInfo, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.level.warn}"
                                              IsChecked="{Binding FilterWarn, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.level.error}"
                                              IsChecked="{Binding FilterError, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.level.fatal}"
                                              IsChecked="{Binding FilterFatal, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <CheckBox Content="{loc:Loc Key=logs.filter.onlyWarnings}"
                                              IsChecked="{Binding OnlyWarningsAndErrors, Mode=TwoWay}" Margin="0,0,10,6" />
                                    <TextBlock Text="{loc:Loc Key=logs.filter.thread}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,6" />
                                    <TextBox Text="{Binding ThreadFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="150"
                                             Margin="0,0,10,6" />
                                    <Button Content="{loc:Loc Key=logs.filter.clear}"
                                            Command="{Binding ClearFiltersCommand}"
                                            Style="{StaticResource ReaderToolButton}" />
                                    <TextBlock Text="{loc:Loc Key=logs.filter.unparsedHint}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,6"
                                               TextWrapping="Wrap" />
                                </WrapPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 底部阅读状态：翻页动作集中在右侧，与已加载范围一起说明“现在看的是哪一段”。 -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                        <!-- F-09 S5：停滞提示只表达不确定，不判定卡死。 -->
                        <TextBlock Text="{Binding StallHint}"
                                   FontSize="10"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasStallHint, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <!-- 证据的锚点位置：崩溃报告与 hs_err 的结论在开头，允许按锚点直接跳转。 -->
                        <Button Content="{loc:Loc Key=logs.evidence.jumpHead}"
                                Command="{Binding JumpEvidenceToHeadCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                Visibility="{Binding IsEvidenceSource, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Loc Key=logs.evidence.jumpTail}"
                                Command="{Binding JumpEvidenceToTailCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                Visibility="{Binding IsEvidenceSource, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{loc:Loc Key=logs.loadOlder}"
                                Command="{Binding LoadOlderCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                IsEnabled="{Binding CanLoadOlder}" />
                        <Button Content="{loc:Loc Key=logs.loadNewer}"
                                Command="{Binding LoadNewerCommand}"
                                Style="{StaticResource ReaderToolButton}"
                                IsEnabled="{Binding CanLoadNewer}"
                                Visibility="{Binding IsEvidenceSource, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding LoadedRangeText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

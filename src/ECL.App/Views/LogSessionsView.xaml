<UserControl x:Class="Ecl.App.Views.LogSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,14,16,8">
                    <TextBlock Text="{loc:Loc Key=logs.title}" Style="{StaticResource HeadingText}" />
                    <Button HorizontalAlignment="Right"
                            Content="{loc:Loc Key=logs.refresh}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshSessionsCommand}" />
                </Grid>
                <ListBox Grid.Row="1"
                         Margin="6,0,6,8"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,6">
                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding State}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentHoverBrush}" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="10"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSession.Title, TargetNullValue='—'}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{Binding SessionDetail}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <CheckBox Content="{loc:Loc Key=logs.follow}"
                              IsChecked="{Binding Follow, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <Button Content="{loc:Loc Key=logs.export}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ExportCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Key=logs.openFolder}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding OpenFolderCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Key=logs.clear}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearViewCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                <ScrollViewer x:Name="LogScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="12,10">
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       FontSize="11"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>

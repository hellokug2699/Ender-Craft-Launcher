<UserControl x:Class="Ecl.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=mods.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=mods.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{loc:Loc Key=common.refresh}"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource GhostButton}"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Instance control / quick actions -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=mods.currentInstance}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding Summary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="250"
                              ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                              ItemTemplate="{StaticResource NameItemTemplate}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <WrapPanel Margin="0,0,0,8">
                <Button Content="{loc:Loc Key=mods.searchDependency}" Command="{Binding SearchSelectedDependencyCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.enableDependencies}" Command="{Binding EnableSelectedDependenciesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.toggle}"
                        Command="{Binding ToggleSelectedCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.enableAll}"
                        Command="{Binding EnableAllCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.disableAll}"
                        Command="{Binding DisableAllCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.import}"
                        Command="{Binding ImportModsCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.importPack}"
                        Command="{Binding ImportModpackCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=mods.exportPack}"
                        Command="{Binding ExportModpackCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8" />
                <Button Content="{loc:Loc Key=common.delete}"
                        Command="{Binding DeleteSelectedCommand}"
                        Style="{StaticResource DangerButton}"
                        Margin="0,0,8,8" />
            </WrapPanel>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Key=mods.installedTitle}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Summary}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Key=mods.searchPlaceholder}" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding ModFilters}" SelectedItem="{Binding SelectedModFilter, Mode=TwoWay}" DisplayMemberPath="Title" />
            </Grid>

            <ListBox ItemsSource="{Binding FilteredMods}"
                     SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                     Margin="0,0,0,18">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Meta}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding IssuesText}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"
                                               Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource Badge}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" FontSize="9" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Resource packs / shaders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=mods.packsTitle}" Style="{StaticResource SectionText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding PackTypes}"
                                  SelectedItem="{Binding SelectedPackType, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource TitleItemTemplate}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PackSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding PackWarning}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding PackHasWarning, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox ItemsSource="{Binding Packs}"
                             SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                             Margin="0,10,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="3" Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc Key=mods.packToggle}" Command="{Binding TogglePackCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=mods.packImport}" Command="{Binding ImportPackCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=common.delete}" Command="{Binding DeletePackCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Ecl.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=mods.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=mods.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{loc:Loc Key=common.refresh}"
                        Command="{Binding ReloadCommand}"
                        Style="{StaticResource GhostButton}"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Instance control / quick actions -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=mods.title}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding Summary}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,5,0,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="250"
                              ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{loc:Loc Key=mods.toggle}"
                        Command="{Binding ToggleSelectedCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="2"
                        Content="{loc:Loc Key=mods.enableAll}"
                        Command="{Binding EnableAllCommand}"
                        Style="{StaticResource GhostButton}" />
                <Button Grid.Column="4"
                        Content="{loc:Loc Key=mods.disableAll}"
                        Command="{Binding DisableAllCommand}"
                        Style="{StaticResource GhostButton}" />
                <Button Grid.Column="6"
                        Content="{loc:Loc Key=mods.import}"
                        Command="{Binding ImportModsCommand}"
                        Style="{StaticResource GhostButton}" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="{loc:Loc Key=mods.importPack}"
                        Command="{Binding ImportModpackCommand}"
                        Style="{StaticResource GhostButton}" />
                <Button Grid.Column="2"
                        Content="{loc:Loc Key=mods.exportPack}"
                        Command="{Binding ExportModpackCommand}"
                        Style="{StaticResource GhostButton}" />
                <Button Grid.Column="4"
                        Content="{loc:Loc Key=common.delete}"
                        Command="{Binding DeleteSelectedCommand}"
                        Style="{StaticResource DangerButton}" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Key=mods.title}" Style="{StaticResource SectionText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Summary}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>

            <ListBox ItemsSource="{Binding Mods}"
                     SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                     Margin="0,0,0,18">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Meta}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding IssuesText}"
                                               Foreground="{StaticResource WarningBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"
                                               Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Style="{StaticResource Badge}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" FontSize="9" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- CurseForge -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=mods.curseforge.title}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{loc:Loc Key=mods.curseforge.subtitle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource Badge}">
                            <TextBlock Text="CurseForge" FontSize="9" Foreground="{StaticResource AccentHoverBrush}" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CurseForgeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Key=mods.curseforge.searchPlaceholder}" />
                        <Button Grid.Column="2"
                                Content="{loc:Loc Key=mods.curseforge.search}"
                                Command="{Binding SearchCurseForgeCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Grid.Column="4"
                                Content="{loc:Loc Key=mods.curseforge.open}"
                                Command="{Binding OpenCurseForgePageCommand}"
                                Style="{StaticResource GhostButton}" />
                    </Grid>
                    <TextBlock Text="{Binding CurseForgeStatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding CurseForgeResults}"
                             SelectedItem="{Binding SelectedCurseForgeResult, Mode=TwoWay}"
                             MaxHeight="240"
                             Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="7"
                                        Padding="10"
                                        Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Meta}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="9"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="{loc:Loc Key=mods.curseforge.install}"
                            Command="{Binding InstallCurseForgeCommand}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Resource packs / shaders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=mods.packsTitle}" Style="{StaticResource SectionText}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding PackTypes}"
                                  SelectedItem="{Binding SelectedPackType, Mode=TwoWay}"
                                  DisplayMemberPath="Title" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PackSummary}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding PackWarning}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding PackHasWarning, Converter={StaticResource BoolToVisibility}}" />
                    <ListBox ItemsSource="{Binding Packs}"
                             SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                             Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock Grid.Column="3" Text="{Binding Meta}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc Key=mods.packToggle}" Command="{Binding TogglePackCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=mods.packImport}" Command="{Binding ImportPackCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        <Button Content="{loc:Loc Key=common.delete}" Command="{Binding DeletePackCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

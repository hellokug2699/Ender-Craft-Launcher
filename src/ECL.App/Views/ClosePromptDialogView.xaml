<UserControl x:Class="Ecl.App.Views.ClosePromptDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        关闭询问内容（F-12）：最小化到托盘 / 退出 / 取消 + “记住我的选择”。
        托盘不可用时只禁用“最小化到托盘”并说明原因，不隐藏另外两个选择。
    -->
    <StackPanel Margin="{StaticResource DialogBodyMargin}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   LineHeight="20"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock Text="{Binding MinimizeUnavailableText}"
                   TextWrapping="Wrap"
                   FontSize="10"
                   Foreground="{DynamicResource WarningBrush}"
                   Margin="0,10,0,0"
                   Visibility="{Binding HasMinimizeUnavailableReason, Converter={StaticResource BoolToVisibility}}" />

        <CheckBox Content="{Binding RememberText}"
                  IsChecked="{Binding RememberChoice, Mode=TwoWay}"
                  Margin="0,14,0,0"
                  AutomationProperties.Name="{Binding RememberText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterSpacing}">
            <Button Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{Binding ExitText}"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" />
            <Button Content="{Binding MinimizeText}"
                    Command="{Binding MinimizeCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanMinimizeToTray}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>

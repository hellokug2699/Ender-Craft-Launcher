<Window x:Class="Ecl.App.Views.WorkspaceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        Title="{Binding Title}"
        Width="800"
        Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">
    <!--
        首次启动向导（ADR 0018；ADR 0052 §11 允许在 Shell 创建前保留独立窗口）。
        布局与交互沿用已批准结构；业务状态在 WorkspaceSetupViewModel 中，窗口只做输入与系统目录选择。
    -->
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding Description}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel>
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasLegacy, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12"
                        BorderBrush="{DynamicResource AccentBorderBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding LegacyTitle}"
                                   Style="{StaticResource EmphasisText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LegacySummary}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,10" />
                        <Button Content="{Binding LegacyAdoptText}"
                                Command="{Binding AdoptLegacyCommand}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding SuggestionsLabel}"
                                   Style="{StaticResource LabelText}" />
                        <ListBox ItemsSource="{Binding Suggestions}"
                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                 Margin="0,8,0,0"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Reason}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding PathLabel}" Style="{StaticResource LabelText}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox"
                                     FontSize="12"
                                     Padding="8,6"
                                     Text="{Binding PathText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="PathBox_TextChanged" />
                            <Button Grid.Column="1"
                                    Content="{Binding BrowseText}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Click="Browse_Click" />
                        </Grid>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{Binding LaterText}"
                    Command="{Binding SkipCommand}"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="1"
                    Content="{Binding AcceptText}"
                    Command="{Binding AcceptCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanAccept}"
                    MinWidth="140" />
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="Ecl.App.Views.InstanceModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        实例工作区「内容 · 模组」二级页（B2 步骤 2 搬迁现有能力；页面布局重写在 B2 步骤 3）。
        本页只拥有自己的滚动容器，不重复工作区大标题。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=instance.detail.mods}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Key=instance.detail.importMods}" Command="{Binding ImportModsCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="{loc:Loc Key=instance.detail.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Key=mods.searchPlaceholder}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ModFilters}" SelectedItem="{Binding SelectedModFilter, Mode=TwoWay}" ItemTemplate="{StaticResource TitleItemTemplate}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding FilteredMods}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}" Height="230" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource SurfaceBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Style="{StaticResource EmphasisText}" />
                                        <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding IssuesText}" Foreground="{DynamicResource DangerBrush}" FontSize="9" TextWrapping="Wrap" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Key=instance.detail.toggleMod}" Command="{Binding ToggleSelectedCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{loc:Loc Key=instance.detail.deleteMod}" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- 依赖处理：下载缺失依赖 / 启用已安装依赖 / 搜索依赖 / 批量启用禁用 -->
                    <Expander Style="{StaticResource SectionExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="{loc:Loc Key=mods.section.dependencies}"
                                       FontSize="12"
                                       Style="{StaticResource EmphasisText}" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=mods.dependenciesHint}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,8" />
                            <WrapPanel>
                                <Button Content="{loc:Loc Key=mods.downloadDependencies}"
                                        Command="{Binding DownloadMissingDependenciesCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Key=mods.enableDependencies}"
                                        Command="{Binding EnableSelectedDependenciesCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Key=mods.searchDependency}"
                                        Command="{Binding SearchSelectedDependencyCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="{loc:Loc Key=mods.enableAll}"
                                        Command="{Binding EnableAllCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Key=mods.disableAll}"
                                        Command="{Binding DisableAllCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 整合包导入 / 导出 -->
                    <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{loc:Loc Key=mods.section.modpack}"
                                       FontSize="12"
                                       Style="{StaticResource EmphasisText}" />
                        </Expander.Header>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.importModpack}"
                                    Command="{Binding ImportModpackCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.exportModpack}"
                                    Command="{Binding ExportModpackCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </Expander>

                    <!-- 资源包与光影（B2b 拆分为独立二级页；在此之前保留现有入口，避免能力回退） -->
                    <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{loc:Loc Key=mods.section.packs}"
                                       FontSize="12"
                                       Style="{StaticResource EmphasisText}" />
                        </Expander.Header>
                        <StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=mods.packsTitle}" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding PackSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PackTypes}" SelectedItem="{Binding SelectedPackType, Mode=TwoWay}" ItemTemplate="{StaticResource TitleItemTemplate}" Width="150" />
                            </Grid>
                            <TextBlock Text="{Binding PackWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedPack, Mode=TwoWay}" Height="130" Margin="0,8,0,0" BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource SurfaceBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="10" Style="{StaticResource EmphasisText}" />
                                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{loc:Loc Key=mods.packImport}" Command="{Binding ImportPackCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Key=mods.packToggle}" Command="{Binding TogglePackCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Key=common.delete}" Command="{Binding DeletePackCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

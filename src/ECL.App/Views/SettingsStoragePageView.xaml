<UserControl x:Class="Ecl.App.Views.SettingsStoragePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        设置中心「存储与路径」页（settings-storage-paths.md，B3 步骤 6）：
        只展示真实由 ECL 消费的路径；唯一可迁移项是 Minecraft 工作区，迁移走
        IWorkspaceMigrationService 的“校验 → 预览影响 → 确认 → 复制/校验/切换 → 失败恢复”。
        本页不清理任何文件；存储清理跳转到存储中心（ADR 0022）。
    -->
    <UserControl.Resources>
        <Style x:Key="StorageRowCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StorageHighlightCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChangeHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StoragePathText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="StorageFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="130" />
        </Style>

        <Style x:Key="StorageHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StoragePlanItem" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:WheelScroll.IsEnabled="True">
            <StackPanel>
                <!-- 有进行中的下载/安装任务时不复制文件，避免得到不一致的工作区副本。 -->
                <Border Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasActiveOperations, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ActiveOperationsText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 路径总览 -->
                <TextBlock Text="{loc:Loc Key=settings.page.storage.paths.title}"
                           Style="{StaticResource SectionText}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{loc:Loc Key=settings.page.storage.paths.description}"
                           Style="{StaticResource StorageHint}"
                           Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StorageRowCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Path}"
                                                   Style="{StaticResource StoragePathText}" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource StorageHint}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Margin="12,0,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="240"
                                                   HorizontalAlignment="Right" />
                                        <Button Content="{loc:Loc Key=settings.page.storage.openFolder}"
                                                Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanOpen}"
                                                Style="{StaticResource GhostButton}"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Minecraft 工作区：唯一可迁移路径，走领域的正式迁移流程。 -->
                <TextBlock Text="{loc:Loc Key=settings.page.storage.change.title}"
                           Style="{StaticResource SectionText}"
                           Margin="0,16,0,4" />
                <TextBlock Text="{loc:Loc Key=settings.page.storage.change.description}"
                           Style="{StaticResource StorageHint}"
                           Margin="0,0,0,8" />

                <Border Style="{StaticResource StorageHighlightCard}"
                        behaviors:HighlightScrollBehavior.IsHighlighted="{Binding IsChangeHighlighted}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Key=settings.page.storage.change.current}"
                                       Style="{StaticResource StorageFieldLabel}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding WorkspaceRow.Path}"
                                       Style="{StaticResource StoragePathText}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding WorkspaceStatusText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding WorkspaceChangeHint}"
                                   Style="{StaticResource StorageHint}"
                                   Margin="0,4,0,0" />

                        <!-- 未完成迁移的恢复：只处理领域记录里真实存在的阶段。 -->
                        <Border Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,10,0,0"
                                Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=settings.page.storage.recovery.title}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RecoveryStageText}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecoveryDetailsText}"
                                           Style="{StaticResource StoragePathText}" />
                                <TextBlock Text="{Binding RecoveryReasonText}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasRecoveryReason, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="{Binding ResumeText}"
                                            Command="{Binding ResumeCommand}"
                                            IsEnabled="{Binding CanResume}"
                                            Style="{StaticResource GhostButton}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding CompleteSwitchText}"
                                            Command="{Binding CompleteSwitchCommand}"
                                            IsEnabled="{Binding CanCompleteSwitch}"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding CanCompleteSwitch, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding DiscardText}"
                                            Command="{Binding DiscardCommand}"
                                            IsEnabled="{Binding CanDiscard}"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 目标位置与迁移计划：只有 ECL 托管工作区可以迁移。 -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding ShowChangeCard, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=settings.page.storage.change.target}"
                                           Style="{StaticResource StorageFieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=settings.page.storage.change.target}" />
                                <Button Grid.Column="2"
                                        Content="{Binding BrowseText}"
                                        Command="{Binding BrowseCommand}"
                                        IsEnabled="{Binding CanChangeWorkspace}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="{loc:Loc Key=settings.page.storage.change.note}"
                                       Style="{StaticResource StorageHint}"
                                       Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button Content="{Binding CheckText}"
                                        Command="{Binding CheckCommand}"
                                        IsEnabled="{Binding CanCheck}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="{Binding StartText}"
                                        Command="{Binding StartCommand}"
                                        IsEnabled="{Binding CanStart}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding PlanStatusText}"
                                       Style="{StaticResource StorageHint}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding PlanStatusText, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding ErrorText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                            <!-- 迁移预览：实例数/文件数/数据体积/目标可用空间与真实阻塞项。 -->
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=settings.page.storage.plan.title}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.source}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanSourceText}"
                                                   Style="{StaticResource StoragePathText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0" />

                                        <TextBlock Grid.Row="1"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.target}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanTargetText}"
                                                   Style="{StaticResource StoragePathText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.instances}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanInstanceText}"
                                                   Style="{StaticResource StorageFieldLabel}"
                                                   Width="Auto"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="3"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.files}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanFileText}"
                                                   Style="{StaticResource StorageFieldLabel}"
                                                   Width="Auto"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="4"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.size}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanSizeText}"
                                                   Style="{StaticResource StorageFieldLabel}"
                                                   Width="Auto"
                                                   FontWeight="SemiBold" />

                                        <TextBlock Grid.Row="5"
                                                   Text="{loc:Loc Key=settings.page.storage.plan.free}"
                                                   Style="{StaticResource StorageFieldLabel}" />
                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="1"
                                                   Text="{Binding PlanFreeSpaceText}"
                                                   Style="{StaticResource StorageFieldLabel}"
                                                   Width="Auto"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding PlanProblems}"
                                                  Margin="0,8,0,0"
                                                  Visibility="{Binding HasPlanProblems, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Style="{StaticResource StoragePlanItem}"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding PlanWarnings}"
                                                  Margin="0,8,0,0"
                                                  Visibility="{Binding HasPlanWarnings, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Style="{StaticResource StoragePlanItem}"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{loc:Loc Key=settings.page.storage.plan.executable}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding PlanCanProceed, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{loc:Loc Key=settings.page.storage.plan.blocked}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding PlanCanProceed, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="{loc:Loc Key=settings.page.storage.plan.sourceKept}"
                                               Style="{StaticResource StorageHint}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 真实迁移阶段与文件计数（复制/校验/切换来自领域进度）。 -->
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding HasMigrationProgress, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding MigrationStageText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding MigrationProgress}"
                                             Maximum="1"
                                             Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ResultText}"
                                           TextWrapping="Wrap"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 存储管理入口：只跳转存储中心，本页不清理文件。 -->
                <TextBlock Text="{loc:Loc Key=settings.page.storage.manage.title}"
                           Style="{StaticResource SectionText}"
                           Margin="0,16,0,4" />
                <TextBlock Text="{loc:Loc Key=settings.page.storage.manage.description}"
                           Style="{StaticResource StorageHint}" />
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=settings.page.storage.manage.note}"
                                   Style="{StaticResource StorageHint}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button Content="{Binding ManageText}"
                                    Command="{Binding OpenStorageCenterCommand}"
                                    IsEnabled="{Binding CanOpenStorage}"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Boundaries}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

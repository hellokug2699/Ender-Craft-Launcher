<UserControl x:Class="Ecl.App.Views.SettingsJavaPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        设置中心「Java 管理」页（java-management.md）：
        全局候选优先级、紧凑单行表格（拖动标志 / 主版本 / 名称 / 路径 / 操作）、
        真实验证状态、只解除登记的“移除”与仅限 ECL 托管运行时的“卸载”。
        列表顺序表达候选优先级；拖动是唯一排序入口，写盘由页面统一完成。
    -->
    <UserControl.Resources>
        <Style x:Key="JavaRowToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="JavaTableHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="JavaRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding StateDetail}" />
        </Style>

        <Style x:Key="JavaDragHandle" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x28FF;" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="ToolTip" Value="{loc:Loc Key=java.page.dragHint}" />
            <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=java.page.dragHint}" />
        </Style>

        <!-- 行模板：列宽与表头共用；验证状态以颜色 + 文字呈现，不改变五列逻辑顺序。 -->
        <DataTemplate x:Key="JavaRowTemplate">
            <Grid MinHeight="46" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="132" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource JavaDragHandle}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding MajorVersionText}"
                               FontSize="14"
                               FontFamily="{StaticResource UiMediumFontFamily}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding MajorVersionText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="7" Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource JavaValidationStateBrush}}" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="9"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding State, Converter={StaticResource JavaValidationStateBrush}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,4">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               Style="{StaticResource EmphasisText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding OriginText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,4">
                    <TextBlock Text="{Binding Path}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding StateDetail}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StateDetail}"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasStateDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Key=java.page.remove}"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource JavaRowToolButton}"
                            ToolTip="{loc:Loc Key=java.page.removeHint}"
                            AutomationProperties.Name="{loc:Loc Key=java.page.remove}" />
                    <Button Content="{loc:Loc Key=java.page.uninstall}"
                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource JavaRowToolButton}"
                            Foreground="{DynamicResource DangerBrush}"
                            Margin="0"
                            ToolTip="{Binding UninstallHint}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="{loc:Loc Key=java.page.uninstall}"
                            AutomationProperties.HelpText="{Binding UninstallHint}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!-- 工具区：重新扫描 / 添加 Java / 验证所选。发现与验证均为异步且有界。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{loc:Loc Key=java.manager.rescan}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}"
                        AutomationProperties.Name="{loc:Loc Key=java.manager.rescan}" />
                <Button Content="{loc:Loc Key=java.page.add}"
                        Command="{Binding AddJavaCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:Loc Key=java.page.add}" />
                <Button Content="{loc:Loc Key=java.page.validateSelected}"
                        Command="{Binding ValidateSelectedCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:Loc Key=java.page.validateSelected}" />
            </StackPanel>

            <TextBlock Text="{Binding CountText}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,0,0,8" />

            <!-- 窄窗口（1080×720）下列表在表格内部横向滚动，页面本身不横向溢出。 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Border MinWidth="600"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="10,7">
                            <Grid Margin="0,0,9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=java.page.column.drag}" Style="{StaticResource JavaTableHeaderText}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Loc Key=java.page.column.major}" Style="{StaticResource JavaTableHeaderText}" Margin="8,0" />
                                <TextBlock Grid.Column="2" Text="{loc:Loc Key=java.page.column.name}" Style="{StaticResource JavaTableHeaderText}" Margin="8,0" />
                                <TextBlock Grid.Column="3" Text="{loc:Loc Key=java.page.column.path}" Style="{StaticResource JavaTableHeaderText}" Margin="8,0" />
                                <TextBlock Grid.Column="4" Text="{loc:Loc Key=java.page.column.actions}" Style="{StaticResource JavaTableHeaderText}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Height="320">
                            <ListBox x:Name="RuntimeList"
                                     ItemsSource="{Binding Runtimes}"
                                     SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource JavaRowTemplate}"
                                     ItemContainerStyle="{StaticResource JavaRowItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     AllowDrop="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="OnRowPreviewMouseLeftButtonDown"
                                     MouseMove="OnRowMouseMove"
                                     DragOver="OnTableDragOver"
                                     Drop="OnTableDrop"
                                     AutomationProperties.Name="{loc:Loc Key=settings.nav.java}" />
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="24,0"
                                       MaxWidth="460"
                                       Visibility="{Binding HasRuntimes, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>

                        <Border Grid.Row="2"
                                Padding="10,6"
                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                BorderThickness="0,1,0,0">
                            <TextBlock Text="{loc:Loc Key=java.page.orderHint}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="10"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap" />

            <!-- “Java 目录 / 路径”与“运行时来源”仍是真实消费的全局设置。
                 窄窗口下与表格一致：保持最小可读宽度并在内部横向滚动，避免把说明文字挤成竖排。 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,18,0,0">
                <ContentControl Content="{Binding SourceGroup}"
                                MinWidth="600"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            </ScrollViewer>
        </StackPanel>
    </ScrollViewer>
</UserControl>

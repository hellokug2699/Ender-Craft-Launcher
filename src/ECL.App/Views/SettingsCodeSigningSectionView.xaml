<UserControl x:Class="Ecl.App.Views.SettingsCodeSigningSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}" />
            <TextBlock Text="{Binding Description}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,5,0,10" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusLabel}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- 证书信息读取失败时不展示空的主题/指纹/有效期，也不显示不可执行的操作按钮。 -->
            <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SubjectLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SubjectText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FingerprintLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FingerprintText}"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ValidityLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ValidityText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding TrustText}"
                            Command="{Binding TrustCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanTrust}" />
                    <Button Content="{Binding RevokeText}"
                            Command="{Binding RevokeCommand}"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="{Binding IsTrusted}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding ActionStatus}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding ActionStatus, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>

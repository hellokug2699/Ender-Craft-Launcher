<UserControl x:Class="Ecl.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:vm="clr-namespace:Ecl.App.ViewModels"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.Resources>
        <!-- 第三方组件行：只呈现已核对的名称、版本、许可证与版权；缺失许可证文本时明确标记。 -->
        <DataTemplate x:Key="ThirdPartyComponentTemplate" DataType="{x:Type vm:ThirdPartyComponentViewModel}">
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="12" Style="{StaticResource EmphasisText}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="{loc:Loc Key=about.thirdParty.licenseLabel}" />
                        <Run Text="{Binding LicenseName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Row="2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                        <Run Text="{loc:Loc Key=about.thirdParty.copyrightLabel}" />
                        <Run Text="{Binding Copyright, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                            <Run Text="{loc:Loc Key=about.thirdParty.versionLabel}" />
                            <Run Text="{Binding VersionText, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="{loc:Loc Key=about.thirdParty.viewLicense}"
                                Command="{Binding DataContext.OpenThirdPartyLicenseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="{Binding HasLicenseText}"
                                Margin="12,0,0,0"
                                MinHeight="0"
                                Padding="10,3"
                                FontSize="11" />
                        <TextBlock Text="{loc:Loc Key=about.thirdParty.missingLicense}"
                                   FontSize="10"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasLicenseText, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <controls:PageHeader Title="{loc:Loc Key=about.title}"
                                 Subtitle="{loc:Loc Key=about.subtitle}" />

            <!-- 1. 品牌与当前版本：只展示真实版本/频道/构建时间/架构。 -->
            <Border Style="{StaticResource HeroCard}" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="74"
                            Height="74"
                            CornerRadius="18"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            Padding="13"
                            VerticalAlignment="Top">
                        <Image Source="{StaticResource EclCompactIcon}" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ECL"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding ProjectName}"
                                   FontSize="13"
                                   Style="{StaticResource EmphasisText}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Tagline}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.version.section}" Style="{StaticResource SectionText}" />

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,12,8">
                            <TextBlock Text="{loc:Loc Key=about.version}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding VersionText}" FontSize="14" Style="{StaticResource HeadingText}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Key=about.channel}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding ChannelText}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0"
                                    Visibility="{Binding HasBuildTime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Key=about.buildTime}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding BuildTimeText}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,0"
                                    Visibility="{Binding ArchitectureText, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{loc:Loc Key=about.architecture}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding ArchitectureText}" FontSize="12" />
                        </StackPanel>
                    </UniformGrid>

                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderSoftBrush}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding CheckUpdatesText}"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsUpdateCheckButtonEnabled}"
                                Style="{StaticResource PrimaryButton}" />
                        <ProgressBar Width="110"
                                     Height="4"
                                     Margin="12,0,0,0"
                                     IsIndeterminate="True"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding UpdateDetailText}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasUpdateDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 2. 项目信息与项目协作（ADR 0049 原生项目中心，不跳转网页替代）。 -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.links.section}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding ProjectDescription}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Key=about.links.repository}"
                                Command="{Binding OpenRepositoryCommand}"
                                Style="{StaticResource GhostButton}" />
                        <Button Content="{loc:Loc Key=about.links.documentation}"
                                Command="{Binding OpenDocumentationCommand}"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=about.links.collaboration.title}"
                                       FontSize="12"
                                       Style="{StaticResource EmphasisText}" />
                            <TextBlock Text="{loc:Loc Key=about.links.collaboration.description}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ProjectCenterRequirementText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ProjectCenterStatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding ProjectCenterDetailText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <Button Content="{loc:Loc Key=about.links.collaboration.manage}"
                                    Command="{Binding OpenProjectCenterManagementCommand}"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 开源许可证：以公共仓库 LICENSE 与发布声明为准。 -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.license.section}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding LicenseName}"
                               FontSize="13"
                               Style="{StaticResource EmphasisText}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Loc Key=about.license.spdx}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Button Content="{loc:Loc Key=about.license.viewText}"
                            Command="{Binding OpenLicenseCommand}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                    <TextBlock Text="{loc:Loc Key=about.license.note}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 4. 第三方组件与许可证：只列出实际随包分发且可核对的组件。 -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.thirdParty.section}" Style="{StaticResource SectionText}" />
                    <ItemsControl ItemsSource="{Binding ThirdPartyComponents}"
                                  ItemTemplate="{StaticResource ThirdPartyComponentTemplate}"
                                  Margin="0,10,0,0" />
                    <TextBlock Text="{loc:Loc Key=about.thirdParty.note}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 5. Contributors：集体署名，不虚构人数或组织。 -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.contributors.section}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding ContributorsName}"
                               FontSize="13"
                               Style="{StaticResource EmphasisText}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Loc Key=about.contributors.description}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Button Content="{loc:Loc Key=about.contributors.view}"
                            Command="{Binding OpenContributorsCommand}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 6. 版权与底部信息。 -->
            <StackPanel Margin="0,2,0,0">
                <TextBlock Text="{Binding ProjectName}" FontSize="11" Style="{StaticResource EmphasisText}" />
                <TextBlock Text="{Binding CopyrightText}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <TextBlock Text="{loc:Loc Key=about.disclaimer}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 页面级状态：只在外部链接或第三方许可证文本打开失败时出现。 -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="10"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

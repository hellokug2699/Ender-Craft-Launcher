<UserControl x:Class="Ecl.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="{loc:Loc Key=about.title}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{loc:Loc Key=about.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />

            <Border Style="{StaticResource Card}" Margin="0,20,0,14">
                <StackPanel>
                    <TextBlock Text="ECL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{loc:Loc Key=about.description}"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,8,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:Loc Key=about.version}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12" />

                        <TextBlock Grid.Row="1" Text="{loc:Loc Key=about.runtime}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Runtime}" FontSize="12" />

                        <TextBlock Grid.Row="2" Text="{loc:Loc Key=about.os}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OperatingSystem}" FontSize="12" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Text="{loc:Loc Key=about.dataDirectory}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DataDirectory}" FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Text="{loc:Loc Key=about.repository}" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RepositoryUrl}" FontSize="11" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="{loc:Loc Key=about.license}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Loc Key=about.disclaimer}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

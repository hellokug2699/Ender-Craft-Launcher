<UserControl x:Class="Ecl.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{loc:Loc Key=about.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="74" Height="74" CornerRadius="18"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            Padding="13">
                        <Image Source="{StaticResource EclCompactIcon}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="ECL" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="ENDER CRAFT LAUNCHER"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{loc:Loc Key=about.description}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=about.version}" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Version}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Key=about.runtime}" Style="{StaticResource LabelText}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding Runtime}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=about.os}" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding OperatingSystem}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc Key=about.license}" Style="{StaticResource LabelText}" Margin="0,16,0,0" />
                        <TextBlock Text="GPL-3.0-or-later" FontSize="12" />
                        <TextBlock Text="{loc:Loc Key=about.fontsLabel}" Style="{StaticResource LabelText}" Margin="0,16,0,0" />
                        <TextBlock Text="{loc:Loc Key=about.fonts}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=about.dataDirectory}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding DataDirectory}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc Key=about.repository}" Style="{StaticResource LabelText}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding RepositoryUrl}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <TextBlock Text="{loc:Loc Key=about.disclaimer}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="Ecl.App.Views.WorldWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实例工作台"
        Width="1120"
        Height="800"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding InstanceName}" Style="{StaticResource TitleText}" FontSize="24" />
                <TextBlock Text="存档、服务器、世界诊断与只读地图。所有浏览操作不会修改世界数据。"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" />
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="存档与地图">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="本地存档"
                                       Style="{StaticResource SectionText}"
                                       Margin="6,4,6,8" />
                            <ListBox ItemsSource="{Binding Worlds}"
                                     SelectedItem="{Binding SelectedWorld}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,5">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                            <TextBlock Text="{Binding Meta}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedWorld.Name}" Style="{StaticResource SectionText}" FontSize="18" />
                                <TextBlock Text="{Binding SelectedWorld.Path}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedWorld.Error}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="备份存档" Command="{Binding BackupSelectedWorldCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                    <Button Content="打开目录" Command="{Binding OpenWorldFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                                    <Button Content="删除存档" Command="{Binding DeleteSelectedWorldCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                                </WrapPanel>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,8,0,12" />
                                <TextBlock Text="只读地图" Style="{StaticResource EmphasisText}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Dimensions}"
                                              SelectedItem="{Binding SelectedDimension}"
                                              ItemTemplate="{StaticResource DisplayNameItemTemplate}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Layers}"
                                              SelectedItem="{Binding SelectedLayer}"
                                              DisplayMemberPath="Name"
                                              Width="130"
                                              Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MapRadius, StringFormat='半径 {0}'}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                    <Button Grid.Column="3"
                                            Content="重新渲染"
                                            Command="{Binding RenderMapCommand}"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding MapSummary}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="9"
                                           Margin="0,6,0,6"
                                           TextWrapping="Wrap" />
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6"
                                        MinHeight="260">
                                    <Image Source="{Binding MapImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock Text="地图来自磁盘上实际保存的区块。未知生物群系/方块使用独立颜色，不会冒充原版内容；诊断标记以红框叠加。"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="多人游戏">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="查询服务器状态" Command="{Binding PingServersCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="查询只读取 servers.dat 并连接服务器，不会启动 Minecraft。"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <ListBox ItemsSource="{Binding Servers}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                            <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                            <TextBlock Text="{Binding Motd}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" />
                                            <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Players}" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Latency}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="世界诊断">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="分析日志与崩溃报告" Command="{Binding AnalyzeDiagnosticsCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="日志异常不等于存档损坏；定位可信度与风险等级分开显示。"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <ListBox ItemsSource="{Binding Diagnostics}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource EmphasisText}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Risk}" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Hypotheses}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="最近访问">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="清空最近访问" Command="{Binding ClearRecentCommand}" Style="{StaticResource GhostButton}" />
                        <TextBlock Text="仅保存在本机，不写入游戏存档，也不上传。"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <ListBox ItemsSource="{Binding Recent}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding Status}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="10"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>

<UserControl x:Class="Ecl.App.Views.InstanceBasicInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:wsvm="clr-namespace:Ecl.App.Workspace.ViewModels"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!-- 基本信息（§10 概览分组默认页）：本页只有一个滚动容器，外围边距由 PageHost 与实例导航提供。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!--
                顶部实例信息区域（instance-workspace.md §2）：横向约 2:1。
                左侧为实例信息与操作，右侧为可选择的 Java 方块；方块颜色与右下角标识共同表达兼容状态。
            -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HeroCard}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding InstanceName}"
                                   FontSize="27"
                                   Style="{StaticResource HeadingText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InstanceMeta}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding InstanceComponents}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InstancePath}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InstancePath}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=instance.detail.minecraft}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                <TextBlock Text="{Binding InstanceMinecraftVersion}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceMinecraftVersion}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc Key=instance.detail.loader}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                <TextBlock Text="{Binding InstanceLoaderText}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceLoaderText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="{loc:Loc Key=instance.detail.created}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                <TextBlock Text="{Binding InstanceCreated}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceCreated}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <TextBlock Text="{loc:Loc Key=instance.detail.lastPlayed}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                <TextBlock Text="{Binding InstanceLastPlayed}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceLastPlayed}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.launch}"
                                    Command="{Binding Operations.LaunchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="120"
                                    Height="38"
                                    Margin="0,0,8,8"
                                    IsEnabled="{Binding Operations.CanOperate}" />
                            <Button Content="{loc:Loc Key=instance.detail.worlds}"
                                    Command="{Binding Operations.OpenWorldWorkbenchCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8"
                                    IsEnabled="{Binding Operations.CanOperate}" />
                            <Button Content="{loc:Loc Key=instances.healthCheck}"
                                    Command="{Binding Operations.CheckHealthCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8"
                                    IsEnabled="{Binding Operations.CanOperate}" />
                            <Button Content="{loc:Loc Key=instances.repairFiles}"
                                    Command="{Binding Operations.RepairFilesCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8"
                                    IsEnabled="{Binding Operations.CanOperate}" />
                            <Button Content="{loc:Loc Key=instance.detail.back}"
                                    Command="{Binding Instances.BackToInstancesCommand}"
                                    Style="{StaticResource ToolbarButton}"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center" />
                            <Button Content="{loc:Loc Key=instance.detail.delete}"
                                    Command="{Binding Operations.DeleteCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Margin="18,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Java 方块：标题/发行版在左上方，右下角用颜色 + 符号双重表达兼容状态。 -->
                <Border Grid.Column="2" Padding="16" MinHeight="220">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                             Value="{x:Static wsvm:JavaCompatibilityBadge.Compatible}">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                             Value="{x:Static wsvm:JavaCompatibilityBadge.Incompatible}">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                             Value="{x:Static wsvm:JavaCompatibilityBadge.IncompatibleAcknowledged}">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Runtime.JavaTile.Title}"
                                       FontSize="20"
                                       Style="{StaticResource EmphasisText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Runtime.JavaTile.Detail}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Runtime.JavaTile.StateText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Runtime.JavaStatus}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding Runtime.JavaOptions}"
                                      SelectedItem="{Binding Runtime.SelectedJavaOption, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                                      AutomationProperties.Name="{loc:Loc Key=instance.detail.java}"
                                      ToolTip="{Binding Runtime.SelectedJavaOption.DisplayName}"
                                      Margin="0,12,0,0" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{loc:Loc Key=instance.detail.selectJava}"
                                        Command="{Binding Runtime.BrowseJavaCommand}"
                                        Style="{StaticResource ToolbarButton}"
                                        Margin="0,0,6,6" />
                                <Button Content="{loc:Loc Key=instances.java.download}"
                                        Command="{Binding Runtime.DownloadJavaCommand}"
                                        Style="{StaticResource ToolbarButton}"
                                        Margin="0,0,6,6" />
                                <Button Content="{loc:Loc Key=instances.java.refresh}"
                                        Command="{Binding Runtime.RefreshJavaCommand}"
                                        Style="{StaticResource ToolbarButton}"
                                        Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Runtime.JavaDownloadStatus}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Runtime.JavaDownloadStatus, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <!-- 状态标识固定在方块右下角（§2.3）。 -->
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="?" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                                     Value="{x:Static wsvm:JavaCompatibilityBadge.Compatible}">
                                            <Setter Property="Text" Value="✓" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                                     Value="{x:Static wsvm:JavaCompatibilityBadge.Incompatible}">
                                            <Setter Property="Text" Value="X" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Runtime.JavaTile.Badge}"
                                                     Value="{x:Static wsvm:JavaCompatibilityBadge.IncompatibleAcknowledged}">
                                            <Setter Property="Text" Value="⚠" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=instances.accountTitle}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{loc:Loc Key=instance.detail.accountDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{loc:Loc Key=instances.accountSettings}"
                                Command="{Binding Instances.EditAccountSettingsCommand}"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="{Binding Instances.CanOpenAccountSettings}"
                                VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Instances.Accounts}"
                                  SelectedItem="{Binding Instances.SelectedAccount, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DisplayNameItemTemplate}" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding Instances.NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Key=instances.accountNamePlaceholder}" />
                        <Button Grid.Column="3"
                                Content="{loc:Loc Key=instances.addAccount}"
                                Command="{Binding Instances.AddAccountCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{loc:Loc Key=instances.signInMicrosoft}" Command="{Binding Instances.SignInMicrosoftCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Key=instances.addThirdParty}" Command="{Binding Instances.AddThirdPartyAccountCommand}" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc Key=instances.microsoftSignInHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Instances.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.detail.jvm}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{loc:Loc Key=instance.detail.jvmDesc}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,12" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=instance.detail.jvmPreset}" Style="{StaticResource LabelText}" />
                            <ComboBox ItemsSource="{Binding Runtime.PresetOptions}" SelectedValue="{Binding Runtime.JvmPreset, Mode=TwoWay}" SelectedValuePath="Value" ItemTemplate="{StaticResource DisplayNameItemTemplate}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Key=instance.detail.memory}" Style="{StaticResource LabelText}" />
                            <CheckBox Content="{loc:Loc Key=instance.detail.memoryUseGlobal}"
                                      IsChecked="{Binding Runtime.UseGlobalMemory, Mode=TwoWay}"
                                      Margin="0,0,0,6" />
                            <TextBox Text="{Binding Runtime.MemoryMbText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Runtime.IsMemoryEditable}"
                                     Visibility="{Binding Runtime.IsMemoryEditable, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="{loc:Loc Key=instance.detail.memoryHint}" />
                            <TextBlock Text="{Binding Runtime.GlobalMemoryText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{loc:Loc Key=instance.detail.presetHelp}" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{loc:Loc Key=instance.detail.presetNote}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Loc Key=instance.detail.extraArgs}" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Runtime.JvmArguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoTextBox}" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc Key=instance.detail.save}" Command="{Binding Runtime.SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding Runtime.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.files}" Style="{StaticResource SectionText}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.openFolder}" Command="{Binding Operations.OpenInstanceFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.openMods}" Command="{Binding Operations.OpenModsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=instance.detail.logs}" Style="{StaticResource SectionText}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=instance.detail.exportLog}" Command="{Binding Operations.ExportLatestLogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.analyzeCrash}" Command="{Binding Operations.AnalyzeCrashCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                            <Button Content="{loc:Loc Key=instance.detail.exportDiagnostics}" Command="{Binding Operations.ExportDiagnosticsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Operations.Operation.CrashAnalysisText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Operations.Operation.DiagnosticStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Operations.StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instance.detail.latestLaunch}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding Operations.Operation.HealthReportText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Operations.Operation.LaunchStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Operations.Operation.LaunchSteps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource LaunchStatusBrush}}" FontSize="10" Style="{StaticResource EmphasisText}" />
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="10" Style="{StaticResource EmphasisText}" />
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Key=instance.detail.commandPreview}" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Operations.Operation.LaunchCommandPreview, Mode=OneWay}" Height="72" />
                    <TextBlock Text="{Binding Operations.Operation.InstallStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

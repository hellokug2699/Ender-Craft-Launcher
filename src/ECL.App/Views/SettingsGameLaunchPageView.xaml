<UserControl x:Class="Ecl.App.Views.SettingsGameLaunchPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        设置中心「游戏与启动」页（settings-game-launch.md）：
        内存分配（自动/手动策略 + 真实系统内存与领域结果）、全局 JVM 参数、
        游戏窗口（宽高联合校验 + 默认全屏）与启动行为。
        页面只显示启动服务的结果，不自行计算内存或拼装启动命令。
    -->
    <UserControl.Resources>
        <Style x:Key="GameHighlightCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMemoryHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameWindowCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWindowHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="150" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:WheelScroll.IsEnabled="True">
            <StackPanel>
                <!-- 内存分配：策略与手动值复用元数据设置行；下方只显示领域计算结果。 -->
                <ContentControl Content="{Binding MemoryGroup}" Margin="0,0,0,8" />

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding MemoryInfoTitle}"
                               Style="{StaticResource SectionText}"
                               Margin="0,0,0,8" />
                    <Border Style="{StaticResource GameHighlightCard}"
                            behaviors:HighlightScrollBehavior.IsHighlighted="{Binding IsMemoryHighlighted}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemoryTotalLabel}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MemoryTotalText}"
                                           FontSize="12"
                                           Style="{StaticResource EmphasisText}" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemoryAvailableLabel}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MemoryAvailableText}"
                                           FontSize="12" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MemoryAllocationText}"
                                           FontSize="12"
                                           Style="{StaticResource EmphasisText}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="{Binding MemoryWarning}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"
                                       Visibility="{Binding HasMemoryWarning, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="{Binding MemoryAlgorithmNote}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0" />
                            <TextBlock Text="{Binding MemoryOverrideNote}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 全局 JVM 参数：实例专属参数优先，ECL 必需参数不会被删除。 -->
                <ContentControl Content="{Binding JvmGroup}" Margin="0,0,0,14" />

                <!-- 游戏窗口：宽度与高度作为一组校验并保存；全屏是独立即时保存的开关键。 -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding WindowTitle}"
                               Style="{StaticResource SectionText}"
                               Margin="0,0,0,8" />
                    <Border Style="{StaticResource GameWindowCard}"
                            behaviors:HighlightScrollBehavior.IsHighlighted="{Binding IsWindowHighlighted}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WindowWidthLabel}"
                                           Style="{StaticResource WindowFieldLabel}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBox Width="120"
                                             Text="{Binding WindowWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding WindowWidthLabel}" />
                                    <TextBlock Text="{Binding WindowUnit}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding WindowHeightLabel}"
                                           Style="{StaticResource WindowFieldLabel}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBox Width="120"
                                             Text="{Binding WindowHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding WindowHeightLabel}" />
                                    <TextBlock Text="{Binding WindowUnit}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,12,0,0"
                                    Padding="0,10,0,0">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding IsFullscreen, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding FullscreenLabel}"
                                              Content="{Binding FullscreenLabel}" />
                                    <TextBlock Text="{Binding FullscreenDescription}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="22,4,0,0" />
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="22,4,0,0">
                                        <Run Text="{Binding FullscreenDefaultText, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding FullscreenSourceText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding WindowError}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"
                                       Visibility="{Binding HasWindowError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding WindowStatus}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"
                                       Visibility="{Binding WindowStatus, Converter={StaticResource StringToVisibility}}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,10,0,0">
                                <Button Content="{loc:Loc Key=settings.page.game.window.apply}"
                                        Command="{Binding ApplyWindowCommand}"
                                        IsEnabled="{Binding CanApplyWindow}"
                                        Style="{StaticResource GhostButton}" />
                                <Button Content="{loc:Loc Key=common.revert}"
                                        Command="{Binding RevertWindowCommand}"
                                        IsEnabled="{Binding CanApplyWindow}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" />
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,8,0,0">
                                <Run Text="{Binding WindowDefaultText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding WindowSourceText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding WindowNote}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="2,7,0,0" />
                </StackPanel>

                <!-- 启动行为：既有启动选项；不提供跳过启动检查或忽略错误的开关。 -->
                <ContentControl Content="{Binding LaunchGroup}" Margin="0,0,0,14" />

                <ContentControl Content="{Binding Boundaries}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Window x:Class="Ecl.App.Views.NbtExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Ecl.App.ViewModels"
        Title="NBT 浏览器（只读）"
        Width="920"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:NbtNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" FontSize="11" />
                <TextBlock Text="{Binding Type}" Foreground="{DynamicResource AccentHoverBrush}" FontSize="9" Margin="8,1,0,0" />
                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="NBT 浏览器（只读）" Style="{StaticResource TitleText}" FontSize="22" />
            <TextBlock x:Name="FilePathText" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
            <TextBlock Text="语义定义与安全编辑属于 NBT Explorer Addition；当前只展示原始标签、类型和值，不写回文件。"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <TreeView x:Name="TagTree" ItemsSource="{Binding Root.Children}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关闭" Click="Close_Click" Style="{StaticResource GhostButton}" />
        </StackPanel>
    </Grid>
</Window>

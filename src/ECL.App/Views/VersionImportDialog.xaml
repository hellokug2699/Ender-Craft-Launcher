<Window x:Class="Ecl.App.Views.VersionImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        Title="{loc:Loc Key=instances.importTitle}"
        Width="660"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}">
    <Border Style="{StaticResource Card}" Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{loc:Loc Key=instances.importTitle}" Style="{StaticResource SectionText}" />
                <TextBlock Text="{loc:Loc Key=instances.importHint}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ListBox x:Name="VersionList" Grid.Row="1" Margin="0,12,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanImport}">
                            <StackPanel Margin="4,2,0,2">
                                <TextBlock Text="{Binding Title}" FontSize="12" />
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,220,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Key=instances.importSelected}"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnImportClick" />
                    <Button Content="{loc:Loc Key=authlib.cancel}"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="Ecl.App.Views.JavaManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Loc Key=java.manager.title}" Style="{StaticResource TitleText}"/>
            <TextBlock Text="{loc:Loc Key=java.manager.description}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
            <Button Content="{loc:Loc Key=java.manager.rescan}" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"/>
            <Button Content="{loc:Loc Key=java.manager.import}" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView ItemsSource="{Binding Runtimes}" SelectedItem="{Binding SelectedRuntime}" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsPriority, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{loc:Loc Key=java.manager.priority}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Architecture}" FontSize="11"/>
                                <TextBlock Text="{Binding SupportState}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding Vendor}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="↑" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Margin="2"/>
                            <Button Grid.Column="4" Content="↓" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Margin="2"/>
                            <Button Grid.Column="5" Content="{loc:Loc Key=java.manager.openFolder}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Margin="2"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0"/>
    </Grid>
</UserControl>

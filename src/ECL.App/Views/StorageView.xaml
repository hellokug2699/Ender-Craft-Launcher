<UserControl x:Class="Ecl.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="38,32,38,32">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="存储与清理" Style="{StaticResource TitleText}" />
                    <TextBlock Text="统计 ECL、下载缓存、Java Runtime、工作区与外部实例来源；清理仅限白名单中的可重建缓存与历史日志。"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="登记实例来源" Command="{Binding AddSourceCommand}" Style="{StaticResource GhostButton}" />
                    <Button Content="扫描" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="实例来源分组" Style="{StaticResource SectionText}" />
                    <TextBlock Text="来源目录只登记并读取；折叠、扫描失败或移除登记都不会删除其中的实例或用户数据。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,5,0,10"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding SourceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,9"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                            <TextBlock Text="{Binding InstancesText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="没有已登记来源。可在工作区设置或上方按钮登记 HMCL、PCL 等目录。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="实例删除" Style="{StaticResource SectionText}" />
                    <TextBlock Text="与实例库使用同一个删除计划与保护规则。默认不选中任何实例；外部实例只移除记录，不删除外部目录。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10"
                               Margin="0,5,0,8"
                               TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding Instances}"
                             SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                             Height="150"
                             Background="{DynamicResource SurfaceAltBrush}"
                             BorderBrush="{DynamicResource BorderSoftBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource EmphasisText}" />
                                    <TextBlock Text="{Binding Meta}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="删除选中实例…"
                                Command="{Binding DeleteSelectedInstanceCommand}"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding HasSelectedInstance}" />
                        <Button Content="预览选中实例清理…"
                                Command="{Binding PreviewSelectedInstanceCleanupCommand}"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="{Binding CanCleanupSelected}"
                                Margin="8,0,0,0" />
                        <TextBlock Text="{Binding InstanceDeletionStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="空间占用" Style="{StaticResource SectionText}" />
                    <ItemsControl ItemsSource="{Binding Usages}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="11" Style="{StaticResource EmphasisText}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeText}"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="安全清理" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding PreviewSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="生成预览"
                                Command="{Binding PreviewCleanupCommand}"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="执行清理"
                                Command="{Binding ExecuteCleanupCommand}"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding HasPreview}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding PreviewItems}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="10" Style="{StaticResource EmphasisText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PathText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeText}"
                                               FontSize="10"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="白名单之外的内容一律不清理：世界存档、模组、配置、资源包、光影包、截图、用户文件与未知目录。"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="9"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="请勿在实例目录中存放与 Minecraft 无关的重要个人文件。ECL 只保护界面明确列出的受支持类别；未知文件默认按用户数据处理。"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="9"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

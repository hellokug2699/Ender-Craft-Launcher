<UserControl x:Class="Ecl.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls">
    <UserControl.Resources>
        <Style x:Key="StorageDiskRingStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{DynamicResource StorageMinecraftBrush}" />
            <Setter Property="StrokeThickness" Value="4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RingState}" Value="low">
                    <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RingState}" Value="unknown">
                    <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="StrokeDashArray" Value="3,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <controls:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <Button Content="{Binding RescanText}"
                            Command="{Binding RescanCommand}"
                            Style="{StaticResource GhostButton}"
                            IsEnabled="{Binding CanScan}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- 扫描中：清空旧结果后只显示明确的扫描状态，不展示旧数据或 0 值。 -->
            <Border Margin="0,0,0,12"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding ScanProgressText}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,8" />
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ScanProgress}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,10"
                    Padding="12,9"
                    CornerRadius="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding WarningText}"
                           FontSize="11"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,0,0,10"
                    Padding="12,8"
                    CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasInstanceFocus, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding InstanceFocusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{loc:Loc Key=storage.clearInstanceFocus}"
                            Command="{Binding ClearInstanceFocusCommand}"
                            Style="{StaticResource ToolbarButton}"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>

            <!-- 汇总与磁盘总览 -->
            <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=storage.diskOverview}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ScanDateText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Disks}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,10,10"
                                        Width="350">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="108" Height="108" HorizontalAlignment="Left">
                                            <Ellipse Style="{StaticResource StorageDiskRingStyle}"
                                                     Fill="{DynamicResource SurfaceBrush}" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding TotalText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="6,4,0,0">
                                            <TextBlock Text="{Binding AvailableText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Segments}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Width}"
                                                                   Height="10"
                                                                   Fill="{Binding BrushKey, Converter={StaticResource StorageSegmentBrush}}"
                                                                   ToolTip="{Binding SizeText}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Segments}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                            <Ellipse Width="7"
                                                                     Height="7"
                                                                     Fill="{Binding BrushKey, Converter={StaticResource StorageSegmentBrush}}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Loc Key=storage.diskSelection}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,6" />
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,0,16,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,12"
                    Style="{StaticResource Card}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=storage.empty.title}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{loc:Loc Key=storage.empty.description}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 清理分类：分类 → 实例（或“全部”）→ 条目；每行最右侧是复选框。 -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource SectionText}"
                                       Margin="2,10,0,8" />
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource EmphasisText}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Note}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TotalSizeText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,12,0" />
                                                    <Button Grid.Column="2"
                                                            Content="{Binding DeleteText}"
                                                            Command="{Binding RequestDeleteCommand}"
                                                            Style="{StaticResource DangerButton}"
                                                            IsEnabled="{Binding CanDelete}"
                                                            VerticalAlignment="Center" />
                                                </Grid>

                                                <Border Height="1"
                                                        Background="{DynamicResource BorderSoftBrush}"
                                                        Margin="0,10,0,2" />

                                                <ItemsControl ItemsSource="{Binding Groups}"
                                                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2,0,4">
                                                                <!-- 实例行：最右侧复选框全选该实例在此分类下的内容。 -->
                                                                <Grid Margin="0,4,4,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="28" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Title}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding SummaryText}"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="8,0,10,0" />
                                                                    <CheckBox Grid.Column="2"
                                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              IsEnabled="{Binding CanSelectAll}"
                                                                              IsThreeState="True"
                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              AutomationProperties.Name="{Binding Title}" />
                                                                </Grid>

                                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="16,3,4,3">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="90" />
                                                                                    <ColumnDefinition Width="28" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding FileName}"
                                                                                               FontSize="11"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               ToolTip="{Binding FileName}"
                                                                                               VerticalAlignment="Center" />
                                                                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                                                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="4"
                                                                                            Padding="5,1"
                                                                                            Margin="8,0,0,0"
                                                                                            VerticalAlignment="Center"
                                                                                            Visibility="{Binding HasKindTag, Converter={StaticResource BoolToVisibility}}">
                                                                                        <TextBlock Text="{Binding KindTag}"
                                                                                                   FontSize="9"
                                                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding SuggestionText}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="10,0,10,0"
                                                                                           Visibility="{Binding IsSelectable, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding SizeText}"
                                                                                           FontSize="10"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           HorizontalAlignment="Right"
                                                                                           VerticalAlignment="Center" />
                                                                                <CheckBox Grid.Column="3"
                                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                          IsEnabled="{Binding IsSelectable}"
                                                                                          HorizontalAlignment="Right"
                                                                                          VerticalAlignment="Center"
                                                                                          AutomationProperties.Name="{Binding FileName}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding EmptyText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="4,10,0,2"
                                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{loc:Loc Key=storage.privacy.note}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="2,8,2,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Ecl.App.Views.SettingsInterfacePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <!--
        设置中心「界面偏好」页（settings-interface-preferences.md）：
        字体与文字、界面缩放、语言、动效四组偏好，加一组“固定边界”说明。
        字体族 / 字号档位 / 语言 / 动效复用元数据设置行；界面缩放需要滑块，
        因此单独成块，但保存仍走同一个配置服务，页面不直接读写配置文件。
    -->
    <UserControl.Resources>
        <Style x:Key="InterfaceScaleCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUiScaleHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:WheelScroll.IsEnabled="True">
            <StackPanel>
                <!-- 字体与文字：界面字体（只列随包且已验证的字体族）与字号档位。 -->
                <ContentControl Content="{Binding FontGroup}" Margin="0,0,0,14" />

                <!-- 界面缩放：滑块 + 当前百分比 + 恢复默认；窗口尺寸不变，Windows 显示缩放不受影响。 -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding UiScaleTitle}"
                               Style="{StaticResource SectionText}"
                               Margin="0,0,0,8" />
                    <Border Style="{StaticResource InterfaceScaleCard}"
                            behaviors:HighlightScrollBehavior.IsHighlighted="{Binding IsUiScaleHighlighted}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Slider Grid.Column="0"
                                        Minimum="80"
                                        Maximum="150"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        Value="{Binding UiScalePercent, Mode=TwoWay}"
                                        AutomationProperties.Name="{Binding UiScaleTitle}"
                                        AutomationProperties.HelpText="{Binding UiScaleDescription}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding UiScaleValueText}"
                                           FontSize="12"
                                           Width="64"
                                           Margin="12,0,0,0"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="{loc:Loc Key=settings.page.interface.scale.reset}"
                                        Command="{Binding ResetUiScaleCommand}"
                                        IsEnabled="{Binding CanResetUiScale}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="14,0,0,0" />
                            </Grid>

                            <TextBlock Text="{Binding UiScaleDescription}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0" />
                            <TextBlock Text="{Binding UiScaleNote}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding UiScaleDefaultText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 语言：保存后需要重启；页面明确显示当前实际使用的语言。 -->
                <ContentControl Content="{Binding LanguageGroup}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding EffectiveLanguageText}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="2,0,0,14" />

                <!-- 动效：用户偏好决定非必要动效；Windows 的减少动画偏好仍是上限。 -->
                <ContentControl Content="{Binding MotionGroup}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding SystemMotionNote}"
                           Foreground="{DynamicResource WarningBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="2,0,0,14"
                           Visibility="{Binding HasSystemMotionLimit, Converter={StaticResource BoolToVisibility}}" />

                <!-- 固定边界：主题色、逐控件字号、字体导入等能力不在本页提供。 -->
                <ContentControl Content="{Binding Boundaries}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

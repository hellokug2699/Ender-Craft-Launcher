<UserControl x:Class="Ecl.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Launcher.RefreshCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <!-- Page heading -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=home.title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="你的 Minecraft 工作台。选择实例，检查环境，然后开始游戏。"
                               Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Key=common.refresh}"
                        Command="{Binding Launcher.RefreshCommand}"
                        Style="{StaticResource GhostButton}" VerticalAlignment="Top" />
            </Grid>

            <!-- Primary action -->
            <Border Style="{StaticResource HeroCard}" Padding="26" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前实例" Style="{StaticResource LabelText}"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Launcher.SelectedInstanceName}"
                                   FontSize="28" Style="{StaticResource HeadingText}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Launcher.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="还没有选择实例" FontSize="24" Style="{StaticResource HeadingText}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding Launcher.HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding Launcher.SelectedInstanceMeta}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,7,0,0"
                                   Visibility="{Binding Launcher.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Launcher.SelectedInstanceComponents}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Launcher.HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox ItemsSource="{Binding Launcher.Instances}"
                                  SelectedItem="{Binding Launcher.SelectedInstance, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource NameItemTemplate}"
                                  Margin="0,16,0,0" MaxWidth="380" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="{loc:Loc Key=home.play}" Command="{Binding Launcher.LaunchCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="150" Height="48"
                                FontSize="14" IsEnabled="{Binding Launcher.HasSelection}" />
                        <Button Content="预览启动命令" Command="{Binding Launcher.DryRunCommand}"
                                Style="{StaticResource GhostButton}" MinWidth="150"
                                Margin="0,9,0,0" IsEnabled="{Binding Launcher.HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Runtime overview -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Loc Key=instances.java.title}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" Style="{StaticResource EmphasisText}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Launcher.JavaStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="账户与实例位置" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding Launcher.SelectedAccount.DisplayName}"
                                   FontSize="12" Style="{StaticResource EmphasisText}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Launcher.SelectedInstancePath}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Launcher.SelectedInstancePath}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Instance picker -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=instances.listTitle}" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding Launcher.Instances.Count, StringFormat={}{0} 个实例}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="管理实例" Command="{Binding OpenInstancesCommand}"
                        Style="{StaticResource GhostButton}" VerticalAlignment="Center" />
            </Grid>
            <ListBox ItemsSource="{Binding Launcher.Instances}"
                     SelectedItem="{Binding Launcher.SelectedInstance, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource InstanceItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     Margin="0,0,0,22">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="210" Padding="15"
                                Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Style="{StaticResource EmphasisText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding VersionText}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="11" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding LastPlayedText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Main destinations -->
            <TextBlock Text="快速入口" Style="{StaticResource SectionText}" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Width="210" Padding="16"
                        Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="发现内容" FontSize="14" Style="{StaticResource EmphasisText}" />
                        <TextBlock Text="搜索 Mod、整合包、数据包、资源包与光影包。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,14" />
                        <Button Content="打开下载中心" Command="{Binding OpenDownloadsCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="210" Padding="16"
                        Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="实例管理" FontSize="14" Style="{StaticResource EmphasisText}" />
                        <TextBlock Text="创建实例、安装游戏与加载器，管理 Java 运行环境。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,14" />
                        <Button Content="管理实例" Command="{Binding OpenInstancesCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="210" Padding="16"
                        Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="已安装内容" FontSize="14" Style="{StaticResource EmphasisText}" />
                        <TextBlock Text="检查 Mod 状态、依赖与冲突，管理实例中的内容。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,14" />
                        <Button Content="打开实例工作区" Command="{Binding OpenWorkspaceCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Latest launch activity -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18"
                    Visibility="{Binding Launcher.HasSelection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最近一次启动" Style="{StaticResource SectionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding Launcher.LaunchStatus}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Launcher.LaunchSteps}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding Status, Converter={StaticResource LaunchStatusBrush}}"
                                               FontSize="11" Style="{StaticResource EmphasisText}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   Style="{StaticResource EmphasisText}" />
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent activity -->
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,18"
                    Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="最近访问" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding RecentSummary}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               Margin="0,5,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Kind}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="12" Style="{StaticResource EmphasisText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

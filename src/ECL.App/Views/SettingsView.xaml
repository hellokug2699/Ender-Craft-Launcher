<UserControl x:Class="Ecl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization">
    <UserControl.Resources>
        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource CompactNavItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding UnavailableReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 窄窗口下的分类选择器：同样用禁用态与文字徽标表达不可用，不只靠颜色。 -->
        <Style x:Key="SettingsNavComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding UnavailableReason}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        设置中心（B3 步骤 1）：左侧纵向二级导航 + 右侧当前分类。
        分类顺序固定为 settings.md §3.2；默认“常规”，未实现的分类只保留准确的不可用状态。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="176"
                Padding="0,0,14,0"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="2,0,0,14">
                    <TextBlock Text="{loc:Loc Key=settings.title}"
                               Style="{StaticResource EmphasisText}"
                               FontSize="14" />
                    <TextBlock Text="{loc:Loc Key=settings.shell.subtitle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Navigation.ItemsView}"
                         SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{loc:Loc Key=settings.nav.title}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 不可用分类：标题下另起一行显示文字徽标，避免英文标题被徽标挤断。 -->
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}"
                                           AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Text="{loc:Loc Key=settings.nav.unavailable.badge}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 窄窗口（<640）下用分类选择器替代左侧导航，避免内容区被压缩到不可用。 -->
            <ComboBox Grid.Row="0"
                      ItemsSource="{Binding Navigation.Items}"
                      SelectedItem="{Binding Navigation.SelectedItem, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource SettingsNavComboItemStyle}"
                      Margin="0,0,0,10"
                      AutomationProperties.Name="{loc:Loc Key=settings.nav.title}"
                      Visibility="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToVisibility}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Grid.Column="1"
                                       Text="{loc:Loc Key=settings.nav.unavailable.badge}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 设置搜索：搜索名称与说明，命中后可定位到具体设置项（settings.md §3.1）。 -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc Key=settings.search.placeholder}" />
                    <TextBlock Text="{loc:Loc Key=settings.search.placeholder}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
                <Button Grid.Column="1"
                        Content="{loc:Loc Key=settings.search.clear}"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- 当前分类标题与按分类恢复默认值。 -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Navigation.CurrentPage.Title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding Navigation.CurrentPage.Subtitle}"
                               Style="{StaticResource SubtitleText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding ResetDefaultsText}"
                        Command="{Binding ResetCurrentPageCommand}"
                        Style="{StaticResource GhostButton}"
                        VerticalAlignment="Top" />
            </Grid>

            <ContentControl Grid.Row="3"
                            Content="{Binding Navigation.CurrentPage}"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- 搜索结果替代内容区；未命中时显示明确空状态。 -->
            <Grid Grid.Row="3" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SearchSummary}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ResourceRowButton}"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="{Binding Description}"
                                        Margin="0,0,0,6"
                                        Padding="12,9">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       Style="{StaticResource EmphasisText}" />
                                            <TextBlock Text="{Binding PageTitle}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="{loc:Loc Key=settings.search.empty}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>


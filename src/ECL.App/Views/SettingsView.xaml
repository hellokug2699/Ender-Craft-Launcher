<UserControl x:Class="Ecl.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:sel="clr-namespace:Ecl.App.Selectors"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.Resources>
        <DataTemplate x:Key="Option.Boolean">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Style="{StaticResource EmphasisText}" />
                            <Border Style="{StaticResource Badge}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=common.restartRequired}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="10"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Option.Number">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Style="{StaticResource EmphasisText}" />
                            <Border Style="{StaticResource Badge}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=common.restartRequired}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="10"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="120"
                                 Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Unit}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Option.Text">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Style="{StaticResource EmphasisText}" />
                            <Border Style="{StaticResource Badge}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=common.restartRequired}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="10"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Width="280"
                             VerticalAlignment="Center"
                             Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Option.Path">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Style="{StaticResource EmphasisText}" />
                            <Border Style="{StaticResource Badge}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=common.restartRequired}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="10"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="360" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2"
                                Content="{loc:Loc Key=common.browse}"
                                Command="{Binding BrowseCommand}"
                                Style="{StaticResource GhostButton}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Option.Select">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Style="{StaticResource EmphasisText}" />
                            <Border Style="{StaticResource Badge}"
                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=common.restartRequired}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentHoverBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="10"
                                   Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SourceText}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="9"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="240"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Choices}"
                              ItemTemplate="{StaticResource DisplayNameItemTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </DataTemplate>

        <sel:OptionTemplateSelector x:Key="OptionTemplateSelector"
                                    BooleanOptionTemplate="{StaticResource Option.Boolean}"
                                    NumberOptionTemplate="{StaticResource Option.Number}"
                                    TextOptionTemplate="{StaticResource Option.Text}"
                                    PathOptionTemplate="{StaticResource Option.Path}"
                                    SelectOptionTemplate="{StaticResource Option.Select}" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Loc Key=settings.title}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{loc:Loc Key=settings.subtitle}" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc Key=settings.scope}"
                       Style="{StaticResource LabelText}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Scopes}"
                      ItemTemplate="{StaticResource TitleItemTemplate}"
                      SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding InstanceChoices}"
                      ItemTemplate="{StaticResource NameItemTemplate}"
                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                      Visibility="{Binding IsInstanceScope, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="5"
                    Content="{loc:Loc Key=common.refresh}"
                    Command="{Binding RefreshInstancesCommand}"
                    Style="{StaticResource GhostButton}"
                    Visibility="{Binding IsInstanceScope, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="7"
                    Content="{loc:Loc Key=settings.save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      behaviors:WheelScroll.IsEnabled="True">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="15"
                                           Style="{StaticResource EmphasisText}"
                                           Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Options}"
                                              ItemTemplateSelector="{StaticResource OptionTemplateSelector}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility"
                                                    Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

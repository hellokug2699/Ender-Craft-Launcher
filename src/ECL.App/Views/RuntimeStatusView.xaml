<UserControl x:Class="Ecl.App.Views.RuntimeStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  KeyboardNavigation.TabNavigation="Cycle"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <controls:SecurityStatusCircle HorizontalAlignment="Center"
                                           Glyph="{Binding Glyph}"
                                           PrimaryText="{Binding RepairText}"
                                           PrimaryEnabled="False"
                                           PrimaryVisibility="{Binding ShowRepair, Converter={StaticResource BoolToVisibility}}">
                <controls:SecurityStatusCircle.Style>
                    <Style TargetType="{x:Type controls:SecurityStatusCircle}">
                        <Setter Property="StatusBrush" Value="{DynamicResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKey}" Value="green">
                                <Setter Property="StatusBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="yellow">
                                <Setter Property="StatusBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKey}" Value="red">
                                <Setter Property="StatusBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:SecurityStatusCircle.Style>
            </controls:SecurityStatusCircle>

            <TextBlock Text="{Binding StatusText}"
                       FontSize="16"
                       Style="{StaticResource EmphasisText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <TextBlock Text="{Binding DetailText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="{StaticResource PageMaxContentWidth}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />

            <!-- 修复交接协议未实现：按钮存在但不可用，并说明 ECL 不会自行修复或提前关闭。 -->
            <Border Style="{StaticResource Card}"
                    Padding="14,10"
                    Margin="0,12,0,0"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    Visibility="{Binding ShowRepair, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding RepairUnavailableText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CoverageText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CheckedAtText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0" />
            </Grid>

            <ProgressBar Height="4"
                         IsIndeterminate="True"
                         Margin="0,10,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{loc:Loc Key=runtime.components.title}"
                       Style="{StaticResource SectionText}"
                       Margin="0,18,0,8" />

            <!-- 表头：健康标记、项目、当前状态、异常原因（右侧预留较大宽度）。 -->
            <Grid Margin="4,0,4,6"
                  Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1"
                           Text="{loc:Loc Key=runtime.components.name}"
                           Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="2"
                           Text="{loc:Loc Key=runtime.components.state}"
                           Style="{StaticResource LabelText}" />
                <TextBlock Grid.Column="3"
                           Text="{loc:Loc Key=runtime.components.reason}"
                           Style="{StaticResource LabelText}" />
            </Grid>

            <ListBox ItemsSource="{Binding Components}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="420"
                     Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     behaviors:WheelScroll.IsEnabled="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 健康状态：颜色实心圆；正常/异常不能只靠颜色，原因列同时给出文字。 -->
                            <Ellipse Width="9"
                                     Height="9"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthKey}" Value="healthy">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKey}" Value="warning">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HealthKey}" Value="damaged">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Name}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding RunStateText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Reason}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource Card}"
                    Padding="18"
                    Margin="0,12,0,0"
                    Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=runtime.empty.title}"
                               Style="{StaticResource SectionText}" />
                    <TextBlock Text="{loc:Loc Key=runtime.empty.description}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

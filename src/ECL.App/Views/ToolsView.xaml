<UserControl x:Class="Ecl.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  behaviors:WheelScroll.IsEnabled="True">
        <StackPanel>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="工具箱" Style="{StaticResource TitleText}" />
                <TextBlock Text="扩展、衣柜与本地诊断。知识和原版工具会明确显示当前可用状态，不把未安装能力伪装成可用。"
                           Style="{StaticResource SubtitleText}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                <TabItem Header="扩展">
                    <Grid DataContext="{Binding Additions}" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CatalogStatus}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="刷新目录" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" />
                                    <ProgressBar Width="120" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="已安装" Style="{StaticResource SectionText}" Margin="0,8,0,6" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Installed}" MaxHeight="260" Margin="0,0,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Style="{StaticResource EmphasisText}" />
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <Run Text="版本 " /><Run Text="{Binding Version}" />
                                                    <Run Text=" · " /><Run Text="{Binding StateText}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="8,3"
                                                        Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="卸载" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,3" Margin="6,0,0,0"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3" Text="可安装" Style="{StaticResource SectionText}" Margin="0,4,0,6" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding Available}" MaxHeight="300" Margin="0,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="12" Style="{StaticResource EmphasisText}">
                                                    <Run Text="{Binding Name}" /><Run Text=" " /><Run Text="{Binding Version}" Foreground="{DynamicResource TextMutedBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="安装"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"
                                                    Padding="12,3" VerticalAlignment="Center"
                                                    Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="衣柜">
                    <Grid DataContext="{Binding Wardrobe}" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="本地衣柜只管理资源文件；不会上传到 ECL 服务器，也不代表游戏内已显示。"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <ComboBox ItemsSource="{Binding TextureTypes}" SelectedItem="{Binding SelectedType}" Width="120" />
                                    <Button Content="导入 PNG" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                                    <ProgressBar Width="110" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" MaxHeight="300">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6">
                                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Style="{StaticResource EmphasisText}" />
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding KindText}" /><Run Text=" · " />
                                                <Run Text="{Binding ModelText}" /><Run Text=" · " />
                                                <Run Text="{Binding SizeText}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="128" Height="128" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8">
                                    <Image Source="{Binding SelectedItem.Preview}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.Name}" FontSize="16" Style="{StaticResource HeadingText}" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="SHA-256 " /><Run Text="{Binding SelectedItem.HashText}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding SelectedItem.FavoriteText}"
                                                Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedItem}"
                                                Style="{StaticResource GhostButton}" />
                                        <Button Content="删除" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}"
                                                Style="{StaticResource DangerButton}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="诊断">
                    <Grid DataContext="{Binding Diagnostics}" Margin="0,12,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="本地诊断中心" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="只读取本地 latest.log 与 crash-reports；默认不上传日志、存档或服务器地址。"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                                  DisplayMemberPath="Name" Width="300" />
                                        <Button Content="开始分析" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                                        <ProgressBar Width="120" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding KnowledgeNote}" FontSize="11" Margin="0,8,0,0"
                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Uncertainty}" FontSize="11" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="知识浏览">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="受限知识浏览器" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding KnowledgeStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="当前状态：WebView2 宿主未实现，页面导航不可用。这是明确的未完成项，不是网络错误。"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="原版工具">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Vanilla Toolkit" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding VanillaStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="数据模板目录：additions/vanilla-toolkit/data-template/（Manifest、Schema 与最小样例）。"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="世界工具">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="世界生成分析（规划中）" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding WorldAnalysisStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="NBT 编辑与修复（规划中）" Style="{StaticResource SectionText}" />
                                <TextBlock Text="{Binding WorldEditingStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

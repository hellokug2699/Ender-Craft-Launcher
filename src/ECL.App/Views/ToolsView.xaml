<UserControl x:Class="Ecl.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:vm="clr-namespace:Ecl.App.ViewModels"
             xmlns:controls="clr-namespace:Ecl.App.Controls"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.Resources>
        <!--
            工具入口卡（迁移规划 §6.2 #12）：名称、用途、真实可用状态与打开入口。
            卡片只读条目元数据；不显示工具内容，也不为未接入能力生成伪按钮。
        -->
        <DataTemplate x:Key="ToolCardTemplate" DataType="{x:Type vm:ToolsCenterTool}">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="16"
                                   Style="{StaticResource EmphasisText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Description}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding Note}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding Note, Converter={StaticResource StringToVisibility}}" />

                    <Button Grid.Row="3"
                            Content="{loc:Loc Key=tools.entry.open}"
                            Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Padding="12,4"
                            MinHeight="0"
                            AutomationProperties.Name="{Binding Title}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 已安装扩展行：只陈述安装记录中的真实字段；运行入口未接入时明确说明。 -->
        <DataTemplate x:Key="AdditionRowTemplate" DataType="{x:Type vm:AdditionToolRow}">
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,0,0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Id}"
                                   FontSize="12"
                                   Style="{StaticResource EmphasisText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,3,0,0">
                        <Run Text="{Binding VersionText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding TypeText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Note}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 工具内容仍由工具自己的 ViewModel 与既有视图标记承载；工具中心不复制领域逻辑。 -->
        <DataTemplate DataType="{x:Type vm:EngineToolsViewModel}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="共享 Instance Inventory 与用户快照" Style="{StaticResource SectionText}" />
                        <TextBlock Text="扫描与快照均在本地完成；恢复通过实例事务执行，并默认先创建恢复前快照。安全扫描已迁入独立安全中心。"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                      DisplayMemberPath="DisplayName" Width="300" />
                            <Button Content="扫描资源" Command="{Binding ScanInventoryCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <ProgressBar Width="110" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IdentityStatus}" FontSize="10" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Inventory" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding InventorySummary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}"
                                 MaxHeight="220" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Kind}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CompatibilityText}" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding EnablementText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="用户快照" Style="{StaticResource SectionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Width="120" />
                            <Button Content="创建快照" Command="{Binding CreateSnapshotCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            <Button Content="恢复选中" Command="{Binding RestoreSnapshotCommand}"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <Button Content="删除选中" Command="{Binding DeleteSnapshotCommand}"
                                    Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                                 MaxHeight="150" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" FontSize="10" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="本地诊断中心" Style="{StaticResource SectionText}" />
                        <TextBlock Text="只读取本地会话登记的日志与证据；默认不上传日志、存档或服务器地址，也不自行枚举实例目录。"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                      DisplayMemberPath="Name" Width="300" />
                            <Button Content="{loc:Loc Key=diagnostics.analyze}" Command="{Binding AnalyzeCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            <Button Content="{loc:Loc Key=diagnostics.refreshHistory}" Command="{Binding RefreshHistoryCommand}"
                                    Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" />
                            <ProgressBar Width="120" Height="4" Margin="12,0,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SessionText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KnowledgeNote}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Uncertainty}" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                        <!-- 证据与推断分开：证据行在前，候选原因/缺失证据单独成段。 -->
                        <TextBlock Text="{loc:Loc Key=diagnostics.findings.title}"
                                   Style="{StaticResource SectionText}" Margin="0,14,0,0" />
                        <TextBlock Text="{loc:Loc Key=diagnostics.findings.empty}"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasFindings, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           Style="{StaticResource EmphasisText}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding SeverityText}" FontSize="11"
                                                           Foreground="{DynamicResource WarningBrush}" Margin="10,0,0,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding ConfidenceText}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Category}" FontSize="10" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <ItemsControl ItemsSource="{Binding EvidenceLines}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   FontFamily="Consolas"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Explanation}" FontSize="11" Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{loc:Loc Key=diagnostics.hypotheses}" FontSize="11"
                                                       Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasHypotheses, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding Hypotheses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" Margin="8,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{loc:Loc Key=diagnostics.missingEvidence}" FontSize="11"
                                                       Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding HasMissingEvidence, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding MissingEvidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" Margin="8,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SuggestedActions}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasSuggestedActions, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Loc Key=diagnostics.history.title}"
                                   Style="{StaticResource SectionText}" Margin="0,14,0,0" />
                        <TextBlock Text="{loc:Loc Key=diagnostics.history.empty}"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" FontSize="10" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 工具入口清单：唯一滚动容器，页面外边距由 PageHost 提供。 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      KeyboardNavigation.TabNavigation="Cycle"
                      behaviors:WheelScroll.IsEnabled="True"
                      Visibility="{Binding HasSelectedTool, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <controls:PageHeader Title="{loc:Loc Key=tools.title}"
                                     Subtitle="{loc:Loc Key=tools.subtitle}">
                    <controls:PageHeader.Actions>
                        <Button Content="{loc:Loc Key=tools.manageAdditions}"
                                Command="{Binding ManageAdditionsCommand}"
                                Style="{StaticResource GhostButton}" />
                    </controls:PageHeader.Actions>
                </controls:PageHeader>

                <!-- 原生工具入口 -->
                <TextBlock Text="{loc:Loc Key=tools.native.section}" Style="{StaticResource SectionText}" />
                <TextBlock Text="{loc:Loc Key=tools.native.description}"
                           Style="{StaticResource SubtitleText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10" />
                <ItemsControl ItemsSource="{Binding Tools}"
                              ItemTemplate="{StaticResource ToolCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 扩展工具：真实安装记录；发布后由扩展管理安装，这里自动出现。 -->
                <TextBlock Text="{loc:Loc Key=tools.additions.section}"
                           Style="{StaticResource SectionText}"
                           Margin="0,14,0,4" />
                <TextBlock Text="{loc:Loc Key=tools.additions.description}"
                           Style="{StaticResource SubtitleText}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                    <Button Content="{loc:Loc Key=tools.additions.refresh}"
                            Command="{Binding RefreshAdditionsCommand}"
                            Style="{StaticResource GhostButton}" />
                    <TextBlock Text="{Binding AdditionsStatus}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasAdditionsError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AdditionsErrorText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="{loc:Loc Key=tools.additions.openManagement}"
                                Command="{Binding ManageAdditionsCommand}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding InstalledAdditions}"
                         ItemTemplate="{StaticResource AdditionRowTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="280"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasInstalledAdditions, Converter={StaticResource BoolToVisibility}}" />

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Visibility="{Binding ShowAdditionsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=tools.additions.empty.title}"
                                   Style="{StaticResource SectionText}" />
                        <TextBlock Text="{loc:Loc Key=tools.additions.empty.description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <Button Content="{loc:Loc Key=tools.additions.openManagement}"
                                Command="{Binding ManageAdditionsCommand}"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 工具内容：条目打开后在同一目的地内显示，并提供键盘可聚焦的返回入口。 -->
        <Grid Visibility="{Binding HasSelectedTool, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{loc:Loc Key=tools.entry.back}"
                        Command="{Binding BackToToolsCommand}"
                        Style="{StaticResource GhostButton}" />
                <TextBlock Text="{Binding SelectedTool.Title}"
                           Style="{StaticResource SectionText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBlock Text="{Binding SelectedTool.StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          KeyboardNavigation.TabNavigation="Cycle"
                          behaviors:WheelScroll.IsEnabled="True">
                <ContentControl Content="{Binding SelectedToolContent}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

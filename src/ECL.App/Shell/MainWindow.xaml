<Window x:Class="Ecl.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ecl.App.Localization"
        xmlns:inspector="clr-namespace:Ecl.App.Shell.Inspector"
        xmlns:output="clr-namespace:Ecl.App.Shell.Output"
        xmlns:dialogs="clr-namespace:Ecl.App.Dialogs.Views"
        Title="{loc:Loc Key=app.name}"
        Icon="/ECL.ico"
        Width="1400"
        Height="880"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 导航项与工作区标签使用条目标题作为无障碍名称，而不是记录类型名。 -->
        <Style x:Key="ShellNavItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
        <Style x:Key="ShellTabItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource TabStripItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavigationCommand}" />
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding ToggleInspectorCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding ToggleOutputCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextWorkspaceCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousWorkspaceCommand}" />
    </Window.InputBindings>

    <Grid>
        <!--
            Application Shell（ADR 0050/0055）：顶部栏、可折叠左侧导航、中央 Workspace Host、
            右侧 Inspector、底部 Output/Task。模态弹窗打开时整个 Shell 被禁用并由弹窗层遮罩。
        -->
        <Grid x:Name="ShellRoot" IsEnabled="{Binding Dialogs.IsShellInteractive}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部栏：全局操作与当前工作区上下文 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,9,16,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding IsNavigationOpen, Mode=TwoWay}"
                                      Style="{StaticResource PanelToggleButton}"
                                      ToolTip="{loc:Loc Key=shell.toggle.navigation}"
                                      AutomationProperties.Name="{loc:Loc Key=shell.toggle.navigation}">
                            <Path Data="{StaticResource IconNavigation}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </ToggleButton>
                        <Border Width="26"
                                Height="26"
                                Margin="10,0,0,0"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Image Source="{StaticResource EclCompactIcon}" Stretch="Uniform" Margin="4" />
                        </Border>
                        <TextBlock Text="ECL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,20,0">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   Style="{StaticResource EmphasisText}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding IsInspectorOpen, Mode=TwoWay}"
                                      Style="{StaticResource PanelToggleButton}"
                                      ToolTip="{loc:Loc Key=shell.toggle.inspector}"
                                      AutomationProperties.Name="{loc:Loc Key=shell.toggle.inspector}">
                            <Path Data="{StaticResource IconInspector}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding Output.IsOpen, Mode=TwoWay}"
                                      Style="{StaticResource PanelToggleButton}"
                                      Margin="8,0,0,0"
                                      ToolTip="{loc:Loc Key=shell.toggle.output}"
                                      AutomationProperties.Name="{loc:Loc Key=shell.toggle.output}">
                            <Path Data="{StaticResource IconOutput}"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局导航 -->
                <Border Grid.Column="0"
                        Width="248"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="0,0,1,0"
                        Visibility="{Binding IsNavigationOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding NavigationView}"
                                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ShellNavItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="12,4,12,12"
                                     AutomationProperties.Name="{loc:Loc Key=shell.navigation}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   AutomationProperties.Name="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Style="{StaticResource EmphasisText}"
                                                           Margin="12,14,0,6" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="22,0,22,18">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="11,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding VersionText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Style="{StaticResource EmphasisText}" />
                                    <TextBlock Text="{Binding BuildTimeText}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding BuildTimeText, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding DataDirectory}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DataDirectory}" />
                                    <TextBlock Text="{Binding GameDirectory}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding GameDirectory}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 中央：Workspace Host + 底部 Output / Task -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,8,16,0"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
                        <ListBox ItemsSource="{Binding Workspaces}"
                                 SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ShellTabItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{loc:Loc Key=shell.workspaces}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Margin="8,0,0,0"
                                                 Fill="{DynamicResource WarningBrush}"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{loc:Loc Key=workspace.tab.unsaved}"
                                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource TabCloseButton}"
                                                Command="{Binding DataContext.CloseWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="8,0,0,0"
                                                ToolTip="{loc:Loc Key=workspace.tab.close}"
                                                AutomationProperties.Name="{loc:Loc Key=workspace.tab.close}"
                                                AutomationProperties.HelpText="{Binding Title}">
                                            <Path Data="{StaticResource IconClose}"
                                                  Width="8"
                                                  Height="8"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                        <Grid>
                            <Ellipse Width="420"
                                     Height="420"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-210,-170,0"
                                     Fill="{DynamicResource AccentGlowBrush}"
                                     Opacity="0.16"
                                     IsHitTestVisible="False" />
                            <ContentControl x:Name="PageHost"
                                            Content="{Binding ActiveWorkspace.Page, NotifyOnTargetUpdated=True}"
                                            TargetUpdated="OnPageTargetUpdated"
                                            Margin="28,22,28,18" />

                            <!-- 空工作区：不是伪工具入口，只提示从导航打开页面 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="420"
                                        Visibility="{Binding HasActiveWorkspace, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=shell.workspace.emptyTitle}"
                                           Style="{StaticResource SectionText}"
                                           TextAlignment="Center" />
                                <TextBlock Text="{loc:Loc Key=shell.workspace.emptyDescription}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <output:OutputPanelView Grid.Row="2" DataContext="{Binding Output}" />
                </Grid>

                <!-- 右侧：Inspector -->
                <Border Grid.Column="2"
                        Width="296"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                    <inspector:InspectorView DataContext="{Binding Inspector}" />
                </Border>
            </Grid>
        </Grid>

        <!-- 统一弹窗层：覆盖整个窗口客户区；没有弹窗时不参与命中测试 -->
        <dialogs:DialogHostView DataContext="{Binding Dialogs}" Panel.ZIndex="10" />
    </Grid>
</Window>

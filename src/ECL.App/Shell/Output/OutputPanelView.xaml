<UserControl x:Class="Ecl.App.Shell.Output.OutputPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             xmlns:behaviors="clr-namespace:Ecl.App.Behaviors">
    <UserControl.Resources>
        <!-- 任务条目：只呈现既有 Operation 快照，不引入第二套任务模型。 -->
        <DataTemplate x:Key="OperationItemTemplate">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   Style="{StaticResource EmphasisText}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StateText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Content="{loc:Loc Key=operations.cancel}"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,2"
                                    MinHeight="0"
                                    FontSize="11"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:Loc Key=operations.retryButton}"
                                    Command="{Binding RetryCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,2"
                                    MinHeight="0"
                                    FontSize="11"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:Loc Key=operations.details}"
                                    Command="{Binding ToggleDetailsCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,2"
                                    MinHeight="0"
                                    FontSize="11"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding StageText}" />
                        <Run Text="{Binding CurrentItem}" />
                    </TextBlock>
                    <ProgressBar Grid.Row="2"
                                 Height="3"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}" />
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SpeedText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EtaText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="4"
                               Text="{Binding DiagnosticText}"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Row="5"
                               Text="{Binding DetailsText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        底部 Output / Task 面板。收起只改变可见性，不启动、暂停或取消任何任务。
        任务数据来自 OperationCenterViewModel，输出数据来自有界应用日志缓冲。
    -->
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Grid Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="16,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource TabStripItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{loc:Loc Key=output.tab.tasks}" FontSize="12" />
                    <ListBoxItem Content="{loc:Loc Key=output.tab.output}" FontSize="12" />
                </ListBox>

                <Button Grid.Column="2"
                        Content="{loc:Loc Key=output.clear}"
                        Command="{Binding ClearOutputCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="10,3"
                        MinHeight="0"
                        FontSize="11"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsOutputTabSelected, Converter={StaticResource BoolToVisibility}}" />

                <Button Grid.Column="3"
                        Content="{loc:Loc Key=output.collapse}"
                        Command="{Binding CollapseCommand}"
                        Style="{StaticResource GhostButton}"
                        Padding="10,3"
                        MinHeight="0"
                        FontSize="11"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc Key=output.collapseHint}" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,6,16,10">
                <!-- 任务视图 -->
                <Grid Visibility="{Binding IsOutputTabSelected, Converter={StaticResource InverseBoolToVisibility}}">
                    <ScrollViewer MaxHeight="190"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:WheelScroll.IsEnabled="True">
                        <StackPanel>
                            <StackPanel Visibility="{Binding Operations.HasActive, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=operations.active}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Style="{StaticResource EmphasisText}"
                                           Margin="0,2,0,2" />
                                <ItemsControl ItemsSource="{Binding Operations.ActiveOperations}"
                                              ItemTemplate="{StaticResource OperationItemTemplate}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Operations.HasRecent, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Key=operations.recent}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Style="{StaticResource EmphasisText}"
                                           Margin="0,2,0,2" />
                                <ItemsControl ItemsSource="{Binding Operations.RecentOperations}"
                                              ItemTemplate="{StaticResource OperationItemTemplate}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Key=output.tasksEmpty}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,4"
                                       Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 输出视图 -->
                <Grid Visibility="{Binding IsOutputTabSelected, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="OutputScroll"
                                  MaxHeight="190"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:WheelScroll.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding OutputEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LevelText}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Category}"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   FontSize="12"
                                                   Margin="10,0,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{loc:Loc Key=output.logEmpty}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,4"
                               Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Ecl.App.Shell.Notifications.NotificationHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Ecl.App.Localization"
             IsHitTestVisible="True">
    <!--
        应用内通知宿主（F-12）：右下角最多 3 条提示，弹窗层（ZIndex=10）始终在它之上。
        提示条本身不执行任务：点击只做导航，关闭只移除提示。
    -->
    <ItemsControl ItemsSource="{Binding Items}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Width="330"
                  Margin="0,0,18,18"
                  AutomationProperties.Name="{loc:Loc Key=notification.host.region}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,8,0,0"
                        Cursor="Hand"
                        AutomationProperties.Name="{Binding Title}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}" />
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource EmphasisText}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{loc:Loc Key=notification.host.openHint}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="9"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{Binding DismissText}"
                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GhostButton}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding DismissText}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

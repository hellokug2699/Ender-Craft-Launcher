<Application x:Class="Ecl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ecl.App.Views"
             xmlns:vm="clr-namespace:Ecl.App.ViewModels"
             xmlns:conv="clr-namespace:Ecl.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:LaunchStatusToBrushConverter x:Key="LaunchStatusBrush" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
                <views:DownloadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceDetailPageViewModel}">
                <views:InstanceDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

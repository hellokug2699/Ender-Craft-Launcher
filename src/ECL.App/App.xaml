<Application x:Class="Ecl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Ecl.App.Views"
             xmlns:vm="clr-namespace:Ecl.App.ViewModels"
             xmlns:wsvm="clr-namespace:Ecl.App.Workspace.ViewModels"
             xmlns:dialogs="clr-namespace:Ecl.App.Dialogs.ViewModels"
             xmlns:dviews="clr-namespace:Ecl.App.Dialogs.Views"
             xmlns:conv="clr-namespace:Ecl.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:LaunchStatusToBrushConverter x:Key="LaunchStatusBrush" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
            <conv:LoaderKindToBrushConverter x:Key="LoaderKindBrush" />
            <conv:DeploymentStatusToBrushConverter x:Key="DeploymentStatusBrush" />
            <conv:ContentVersionStatusToBrushConverter x:Key="ContentVersionStatusBrush" />

            <!-- 页面 ViewModel → 视图映射；工作区只切换 DataContext，不直接构造视图。 -->
            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                <views:ToolsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
                <views:DownloadView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstanceVersionPageViewModel}">
                <views:InstanceVersionPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ContentDiscoveryViewModel}">
                <views:ContentDiscoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageViewModel}">
                <views:StorageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:InstanceDetailPageViewModel}">
                <views:InstanceDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:InstanceBasicInfoViewModel}">
                <views:InstanceBasicInfoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:InstanceModifyViewModel}">
                <views:InstanceModifyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:InstanceModsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:ContentPackPageViewModel}">
                <views:InstanceContentPacksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:InstanceDataPacksViewModel}">
                <views:InstanceDataPacksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:ScreenshotPageViewModel}">
                <views:InstanceScreenshotsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:SchematicPageViewModel}">
                <views:InstanceSchematicsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type wsvm:InstanceExportViewModel}">
                <views:InstanceExportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JavaManagementViewModel}">
                <views:JavaManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogSessionsViewModel}">
                <views:LogSessionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>

            <!-- 统一弹窗内容：新增弹窗只需提供内容 ViewModel，不创建窗口。 -->
            <DataTemplate DataType="{x:Type dialogs:MessageDialogViewModel}">
                <dviews:MessageDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:InstanceDirectoryDialogViewModel}">
                <dviews:InstanceDirectoryDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ModifyConfirmDialogViewModel}">
                <dviews:ModifyConfirmDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ContentDetailDialogViewModel}">
                <dviews:ContentDetailDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:ContentTargetDialogViewModel}">
                <dviews:ContentTargetDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type dialogs:DatapackTargetDialogViewModel}">
                <dviews:DatapackTargetDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type dialogs:ModpackModListDialogViewModel}">
                <dviews:ModpackModListDialogView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

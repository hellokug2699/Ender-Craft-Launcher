<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ecl.App</RootNamespace>
    <AssemblyName>ECL</AssemblyName>
    <ApplicationIcon>ECL.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECL.Core\ECL.Core.csproj" />
    <ProjectReference Include="..\ECL.Download\ECL.Download.csproj" />
    <ProjectReference Include="..\ECL.Deployment\ECL.Deployment.csproj" />
    <ProjectReference Include="..\ECL.Configuration\ECL.Configuration.csproj" />
    <ProjectReference Include="..\ECL.Auth\ECL.Auth.csproj" />
    <ProjectReference Include="..\ECL.Java\ECL.Java.csproj" />
    <ProjectReference Include="..\ECL.Minecraft\ECL.Minecraft.csproj" />
    <ProjectReference Include="..\ECL.Sessions\ECL.Sessions.csproj" />
    <ProjectReference Include="..\ECL.Operations\ECL.Operations.csproj" />
    <ProjectReference Include="..\ECL.Additions\ECL.Additions.csproj" />
    <ProjectReference Include="..\ECL.Wardrobe\ECL.Wardrobe.csproj" />
    <ProjectReference Include="..\ECL.Diagnostics\ECL.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标：同时嵌入 EXE（ApplicationIcon）并作为 WPF 资源供窗口使用。 -->
    <Resource Include="ECL.ico" />
    <!-- HarmonyOS Sans SC：随程序内嵌，未做任何修改；许可证文本随输出分发。 -->
    <Resource Include="Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <Resource Include="Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
    <Resource Include="Fonts\HarmonyOS_Sans_SC_Bold.ttf" />
    <Content Include="Fonts\HarmonyOS_Sans_LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 线程与有界输出管线的并发回归测试需要访问 App 内部类型（见 tests/ECL.App.Tests）。 -->
    <InternalsVisibleTo Include="Ecl.App.Tests" />
  </ItemGroup>

</Project>

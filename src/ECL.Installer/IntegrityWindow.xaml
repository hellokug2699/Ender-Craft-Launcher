<Window x:Class="Ecl.Installer.IntegrityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装前完整性核对"
        Width="720"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0F0E14"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F2F7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="安装前完整性核对" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="在写入程序文件或导入任何证书之前，请使用 Windows 自带 PowerShell 独立计算当前安装程序的 SHA-256，并与官方发布摘要逐字符比较。"
                       Foreground="#A6A2B5"
                       Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
            <StackPanel>
                <TextBlock Text="当前文件" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBox x:Name="FileText" IsReadOnly="True" Background="#1B1824" Foreground="#F3F2F7" BorderBrush="#2B2539" Padding="10,7" />
                <TextBlock Text="官方摘要" FontWeight="Bold" Margin="0,14,0,4" />
                <TextBox x:Name="OfficialHashText" IsReadOnly="True" FontFamily="Consolas" Background="#1B1824" Foreground="#F3F2F7" BorderBrush="#2B2539" Padding="10,7" />
                <TextBlock Text="本机文件 SHA-256（程序自检）" FontWeight="Bold" Margin="0,14,0,4" />
                <TextBox x:Name="LocalHashText" IsReadOnly="True" FontFamily="Consolas" Background="#1B1824" Foreground="#F3F2F7" BorderBrush="#2B2539" Padding="10,7" />

                <TextBlock Text="请在 PowerShell 中执行（复制命令后替换为你下载的文件路径）：" FontWeight="Bold" Margin="0,16,0,4" />
                <TextBox x:Name="CommandText" IsReadOnly="True" FontFamily="Consolas" Background="#1B1824" Foreground="#F3F2F7" BorderBrush="#2B2539" Padding="10,7" TextWrapping="Wrap" />
                <TextBlock Text="步骤：打开 PowerShell → 执行上方命令 → 读取 Hash 字段 → 与官方摘要逐字符比较。仅打开 PowerShell 或复制命令不代表验证通过。"
                           Foreground="#A6A2B5" FontSize="12" Margin="0,8,0,0" />

                <Border x:Name="StatusBorder" Background="#271E3D" BorderBrush="#3D2C63" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" />
                </Border>
                <TextBlock Text="提示：哈希一致只能证明本地文件与所用摘要一致；若 GitHub 账号、Release 发布链或摘要来源被同时攻陷，仍无法排除替换。该步骤不能替代 Authenticode 或 ECL 更新 Manifest 验签。"
                           Foreground="#E9B949" FontSize="11" Margin="0,14,0,0" />
                <TextBlock Text="跳过核对或摘要不可用时，安装文件处于“未验证”状态；ECL 不会把它显示为验证通过。"
                           Foreground="#E9B949" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消安装" Click="Cancel_Click" Background="#1C1926" Foreground="#F3F2F7" BorderBrush="#2B2539" />
            <Button x:Name="SkipButton" Content="跳过并继续（未验证）" Click="Skip_Click" Background="#1C1926" Foreground="#F3F2F7" BorderBrush="#2B2539" />
            <Button x:Name="ConfirmButton" Content="我已逐字符核对一致" Click="Confirm_Click" Background="#9A6CFF" Foreground="#150B26" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>

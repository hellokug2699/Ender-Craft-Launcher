<Window x:Class="Ecl.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ender Craft Launcher 安装程序" Width="760" Height="570" MinWidth="700" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" FontFamily="{StaticResource UiFont}" Icon="/ECL.ico">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel>
        <TextBlock Text="ENDER CRAFT LAUNCHER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="把方块世界，装进启动器。" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock Text="安装 ECL · 安全校验 · 独立版本管理" Foreground="{StaticResource Muted}" FontSize="13"/>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource PanelAlt}" CornerRadius="9" Padding="11,7"><TextBlock Text="INSTALLER  /  NIGHTLY" FontSize="10" Foreground="{StaticResource Muted}"/></Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,25,0,22">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="安装位置" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="ECL 程序文件将安装到此目录。实例、账户和游戏数据不会放在这里。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14"/>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="InstallPathBox" Height="38" VerticalContentAlignment="Center" Padding="10,0" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" BorderThickness="1" FontFamily="Consolas"/>
          <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="Browse_Click"/>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource PanelAlt}" CornerRadius="9" Padding="13" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="安全安装流程" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="安装包签名验证  ·  SHA-256 完整性校验  ·  独立版本目录  ·  原子切换" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
          <ProgressBar x:Name="InstallProgress" Height="4" IsIndeterminate="False" Visibility="Collapsed" Background="{StaticResource PanelAlt}" Foreground="{StaticResource Accent}" BorderThickness="0"/>
          <TextBlock x:Name="StatusText" Text="准备就绪。选择安装目录，然后开始安装。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <TextBlock Text="ECL · Ender Craft Launcher" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="退出" Margin="0,0,10,0" Click="Exit_Click"/>
        <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="Install_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ecl.Cli</RootNamespace>
    <AssemblyName>ecl</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECL.Core\ECL.Core.csproj" />
    <ProjectReference Include="..\ECL.Deployment\ECL.Deployment.csproj" />
    <ProjectReference Include="..\ECL.Download\ECL.Download.csproj" />
    <ProjectReference Include="..\ECL.Configuration\ECL.Configuration.csproj" />
    <ProjectReference Include="..\ECL.Auth\ECL.Auth.csproj" />
    <ProjectReference Include="..\ECL.Java\ECL.Java.csproj" />
    <ProjectReference Include="..\ECL.Minecraft\ECL.Minecraft.csproj" />
    <ProjectReference Include="..\ECL.Diagnostics\ECL.Diagnostics.csproj" />
    <ProjectReference Include="..\ECL.Operations\ECL.Operations.csproj" />
    <ProjectReference Include="..\ECL.Sessions\ECL.Sessions.csproj" />
    <!-- CLI 启动游戏时同样需要独立日志宿主，否则会降级为进程内采集并记录“采集降级”。 -->
    <ProjectReference Include="..\ECL.LogHost\ECL.LogHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyLogHostForLocalRun" AfterTargets="Build">
    <ItemGroup>
      <LogHostRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\ECL.LogHost.exe" />
      <LogHostRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\ECL.LogHost.dll" />
      <LogHostRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\ECL.LogHost.deps.json" />
      <LogHostRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\ECL.LogHost.runtimeconfig.json" />
      <LogHostRuntimeFiles Include="$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\Ecl.LogHost.Contracts.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LogHostRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\ECL.LogHost\bin\$(Configuration)\net10.0\ECL.LogHost.exe')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>

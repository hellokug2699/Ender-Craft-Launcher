<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Product>Ender Craft Launcher</Product>
    <Company>Ender Craft Launcher Contributors</Company>
    <Authors>Ender Craft Launcher Contributors</Authors>
    <Copyright>Copyright (C) 2026 Ender Craft Launcher Contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <RepositoryUrl>https://github.com/hellokug2699/Ender-Craft-Launcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
